# 服务端本地开发环境变量
#
# 本地开发默认走 dev 配置（application-dev.yml），不需要设 SPRING_PROFILES_ACTIVE。
# 生产由 Dockerfile 与 docker-compose 强制 prod，见技术文档 1.6。
#
# 两种填法：
#   A. IDEA：Run/Debug Configurations -> Environment variables 里逐条添加（推荐，不受 shell 转义影响）
#   B. Git Bash：
#        cp .env.example .env   # 填好值
#        set -a; source .env; set +a
#        mvn spring-boot:run
#      注意：值里含 & * ? 的一律用双引号包住，否则会被 shell 解释掉。
#
# 不要把真实密钥提交进代码库（.gitignore 已排除 .env）

# 必填：HS256 密钥，至少 32 字节。生成方式：openssl rand -base64 48
APP_JWT_SECRET=""

# 必填：小程序 AppID / AppSecret（微信公众平台 -> 开发管理 -> 开发设置）
APP_WX_APP_ID=""
APP_WX_APP_SECRET=""

# 数据库
APP_DB_URL="jdbc:mysql://127.0.0.1:3306/meal_order?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
APP_DB_USER="meal"
APP_DB_PASSWORD=""

# 图片目录与日志目录
APP_UPLOAD_DIR="./data/upload"
APP_LOG_DIR="./logs"

# 图片压缩：原图上限（MB）、压缩后长边（px）、JPEG 质量（0~1）
APP_UPLOAD_MAX_SIZE_MB="15"
APP_UPLOAD_MAX_EDGE="1200"
APP_UPLOAD_JPEG_QUALITY="0.82"

# 定时任务（每 5 分钟扫描超时未转账订单）
APP_SCHEDULE_ENABLED="true"
APP_PREPAY_RELEASE_CRON="0 */5 * * * *"

# 标签小程序码：保留天数（超期的 qr/*.png 由定时任务删除，重打时按需重生成）与清理时间
APP_QR_KEEP_DAYS="180"
APP_QR_CLEANUP_CRON="0 40 3 * * *"

# 网页后台本地开发跨域来源
APP_ALLOWED_ORIGINS="http://localhost:5173"

# 商家初始账号：库里没有该 username 时启动自动创建一次，已存在则不覆盖
# 研发阶段约定 admin/admin，上线前必须改密码
APP_ADMIN_USERNAME="admin"
APP_ADMIN_PASSWORD="admin"
APP_ADMIN_INIT_ENABLED="true"

# 联系顾客：调取完整号码的三重限制（隐私合规，按需 / 限次 / 留痕，不给后台可调）
# 同一单 24h 内最多几次 / 同一操作人每天最多几次 / 订单结束后还能调几天（0 = 一结束就不可调）
APP_CONTACT_PHONE_MAX_PER_ORDER_24H="5"
APP_CONTACT_PHONE_MAX_PER_OPERATOR_DAY="100"
APP_CONTACT_PHONE_WINDOW_DAYS="7"

# 邀请码核销防爆破：连续错几次锁定、锁多少分钟
APP_INVITE_LOCK_MAX_FAILURES="10"
APP_INVITE_LOCK_MINUTES="30"

# 商家后台登录失败锁定：连续错几次锁定、锁多少分钟
APP_AUTH_LOGIN_LOCK_MAX_FAILURES="3"
APP_AUTH_LOGIN_LOCK_MINUTES="30"

# 首页通知横栏最多带几条未读（只影响首页那一行，消息中心列表是分页）
APP_MESSAGE_HOME_UNREAD_LIMIT="3"
