<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志：控制台 + 文件双输出，按天 + 100MB 滚动，保留 30 天、总量封顶 2GB。
  磁盘占用的大头是日志，这三项上限是必须的（见技术文档 1.4 三条运维约束）。
-->
<configuration>

    <!--
      手机号兜底脱敏：业务代码已不打全号，这里再拦一道，
      防的是将来有人随手把号码拼进日志。见 PhoneMaskingConverter。
    -->
    <conversionRule conversionWord="maskedMsg"
                    converterClass="com.xxxfhf.meal.common.log.PhoneMaskingConverter"/>

    <property name="LOG_DIR" value="${APP_LOG_DIR:-./logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %maskedMsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/meal-order.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/meal-order.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 框架启动期的噪音日志压掉，业务日志保持 INFO -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
