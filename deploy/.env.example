# =============================================================================
# 部署环境变量。复制为 .env（同目录）后填值，docker compose 会自动读取。
#
# 注意：密码请使用「字母 + 数字」组合，避免 @ : / ? & 等字符。
#       这些字符出现在 MYSQL_PASSWORD 里会破坏 JDBC URL 的解析。
# =============================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ---------- 应用 ----------
# 运行 profile 固定为 prod（Dockerfile ENV + docker-compose 双重指定），此处不用配。
# prod 下下列变量全部无默认值：缺任何一个，容器会在启动时报
# "Could not resolve placeholder" 直接退出，而不是带着空密码跑起来。

# HS256 密钥，至少 32 字节。生成：openssl rand -base64 48
APP_JWT_SECRET=

# 微信小程序凭据（微信公众平台 -> 开发管理 -> 开发设置）
APP_WX_APP_ID=
APP_WX_APP_SECRET=

# ---------- 商家初始账号 ----------
# 首次启动时若库中无该账号则自动创建；已存在则不覆盖（改过密码不会被重启清掉）
# 研发阶段按约定用 admin/admin，上线前必须改掉，或改成强口令后重启一次
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
APP_ADMIN_INIT_ENABLED=true

# ---------- 应用层限流 ----------
# 只补 nginx 按 IP 之外的「按人」维度；nginx 那层仍在（30r/s），这里挡的是「同一个人慢慢刷」。
# 四个变量都有默认值，不配也能启动；改了要重启 jar 才生效（配置是启动时绑定的）。
# true = 只记日志不拦截，用于观察真实峰值。看几天日志确认没冤枉正常人后改成 false，即刻开始拦截。
APP_RATE_LIMIT_DRY_RUN=true
# 登录用户额度（次/窗口）。正常点餐峰值 20~30 次/分钟（进页面 3 个 + 切 Tab + 下单 + 刷新）
APP_RATE_LIMIT_LIMIT=60
# 窗口秒数。不要按秒：小程序进页面时 onShow 会在同一秒并发发 3 个请求
APP_RATE_LIMIT_WINDOW_SECONDS=60
# 免登录入口（登录 / 首次登记 / 后台登录）按 IP 的额度，必须 ≤ APP_RATE_LIMIT_LIMIT
APP_RATE_LIMIT_LOGIN_LIMIT=10

# ---------- 启动路径 ----------
# jar 在服务器上的完整路径，server/start-app.sh 与 server/stop-app.sh 共用
APP_JAR_PATH=

# ---------- JVM ----------
# jar 启动参数，多个参数用空格分隔。compose 不读这个变量，只有 server/start-app.sh 用。
# 注意：.env 会被 server/start-app.sh source 进 shell，含空格的值必须整体加引号，
#       否则 "-Xmx512m" 会被当成命令执行，报 command not found。
# 服务器内存小，建议显式限堆，示例（按你服务器实际内存调整）：
#   JAVA_OPTS="-Xms256m -Xmx512m"
JAVA_OPTS=""
