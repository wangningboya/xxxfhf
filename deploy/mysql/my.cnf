[mysqld]
# 字符集
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# 时区：与服务端、小程序保持一致（截单判定依赖服务端时间，时区错会整体偏移）
default-time-zone = '+08:00'

# 内存：2 核 4G 机器上与 JVM 共存，这里给 512M，剩余留给 JVM 与系统
# 依据见技术文档 1.4：MySQL 0.8G + JVM 1.2G + 系统 0.4G ≈ 2.4G
innodb_buffer_pool_size = 512M
innodb_redo_log_capacity = 256M

# 连接：单实例小流量，100 足够；应用侧 Hikari 只开 10
max_connections = 100

# 慢查询：超过 1 秒记下来，用于观察备菜统计那类聚合查询
slow_query_log = 1
long_query_time = 1
slow_query_log_file = /var/lib/mysql/slow.log

# 关闭 DNS 反解，减少连接开销
skip-name-resolve

# 存储引擎默认
default-storage-engine = InnoDB

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
