/* 全局基础样式。页面级样式各自写在 page.wxss 里，这里只放真正通用的东西。 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1a1a1a;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
}

/*
 * 状态标签配色，取自数据字典的 tagType。
 *
 * 字典里能配的只有这六种（`primary` / `success` / `warning` / `danger` / `info` / `default`），
 * 与网页后台 Element Plus 的 el-tag 保持同一套语义，商家在后台改一个颜色两端一起变。
 * 字典缺项或没加载出字典时走 `tag-default`，不会出现无样式文字。
 */
.tag-primary {
  color: #2f6fed;
}

.tag-success {
  color: #2e9e5b;
}

.tag-warning {
  color: #d97600;
}

.tag-danger {
  color: #d93a3a;
}

.tag-info {
  color: #8a8a8a;
}

.tag-default {
  color: #4a4a4a;
}

/*
 * 月销量角标：压在封面左下角。
 *
 * 为什么压在图上而不是另起一行：点餐页的封面只有 132rpx，右侧文案区已经被
 * 「菜名 / 组成 / 价格 + 已订 X 共 Y / 进度条」占满，再加一行只会把列表撑高。
 *
 * 尺寸不写死：宽度由文字撑开，字号由各页面覆盖（132/180rpx 封面 20rpx，详情页大图 26rpx）。
 */
.sold-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  max-width: 100%;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
  border-top-right-radius: 10rpx;
  white-space: nowrap;
  overflow: hidden;
}
