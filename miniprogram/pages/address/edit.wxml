<view class="page">
  <view class="tip" wx:if="{{pendingTip || isEdit}}">修改后需要商家重新确认才能用于下单</view>

  <view class="card">
    <picker
      class="row"
      mode="selector"
      range="{{regions}}"
      range-key="name"
      value="{{regionIndex}}"
      bindchange="onRegionChange"
    >
      <text class="label">区域</text>
      <text class="value {{regionName ? '' : 'value-ph'}}">{{regionName || '请选择所属区域'}}</text>
      <text class="arrow">›</text>
    </picker>

    <view class="row">
      <text class="label">收货人</text>
      <input
        class="input"
        value="{{contactName}}"
        data-field="contactName"
        placeholder="姓名"
        placeholder-class="ph"
        maxlength="20"
        bindinput="onInput"
      />
    </view>

    <view class="row">
      <text class="label">手机号<text class="req">*</text></text>
      <input
        class="input"
        type="number"
        value="{{phone}}"
        data-field="phone"
        placeholder="11 位手机号"
        placeholder-class="ph"
        maxlength="11"
        bindinput="onInput"
      />
    </view>
    <!-- 用途告知：收集目的、范围、政策入口（隐私整改 P0-10） -->
    <view class="hint">
      仅用于配送或取餐时联系你，不用于营销。<text class="hint-link" bindtap="onOpenPrivacy">查看《隐私政策》</text>
    </view>

    <view class="row row-column">
      <text class="label">详细地址</text>
      <textarea
        class="textarea"
        value="{{detail}}"
        data-field="detail"
        placeholder="楼栋、单元、门牌号"
        placeholder-class="ph"
        maxlength="100"
        bindinput="onInput"
      />
    </view>

    <view class="row">
      <text class="label">标签</text>
      <view class="tags">
        <view
          class="tag {{tag === item ? 'tag-active' : ''}}"
          wx:for="{{tags}}"
          wx:key="*this"
          data-tag="{{item}}"
          bindtap="onPickTag"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <view class="save {{saving ? 'save-disabled' : ''}}" bindtap="onSave">
    {{saving ? '提交中…' : '保存'}}
  </view>

  <!-- 保存地址前的隐私提示，由 utils/privacy.js 唤起 -->
  <privacy-modal id="privacyModal" />
</view>
