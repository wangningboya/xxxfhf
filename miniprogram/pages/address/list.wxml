<view class="page">
  <view class="tip-top" wx:if="{{mode === 'select'}}">选择一个收货地址</view>

  <view class="empty" wx:if="{{!loading && !groups.length}}">
    <view class="empty-title">还没有收货地址</view>
    <view class="empty-desc">新增后需要商家确认才能用于下单</view>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="name" wx:for-item="group">
    <view class="group-name">{{group.name}}</view>
    <view
      class="addr"
      wx:for="{{group.items}}"
      wx:key="id"
      wx:for-item="addr"
      data-id="{{addr.id}}"
      data-status="{{addr.status}}"
      bindtap="onPick"
    >
      <view class="addr-main">
        <view class="addr-line1">
          <text class="contact">{{addr.contactName}}</text>
          <text class="phone">{{addr.phone}}</text>
          <text class="tag" wx:if="{{addr.tag}}">{{addr.tag}}</text>
        </view>
        <view class="addr-line2">{{addr.regionName}} {{addr.detail}}</view>
        <view class="addr-pending" wx:if="{{addr.status === 'pending'}}">待商家确认，暂不能下单用</view>
        <!-- 驳回要把原因原样给用户：他才知道该改哪一段，而不是反复提交同一条 -->
        <view class="addr-reject" wx:if="{{addr.status === 'rejected'}}">
          商家驳回：{{addr.rejectReason || '请修改后重新提交'}}
        </view>
      </view>
      <view class="addr-edit" data-id="{{addr.id}}" catchtap="onEdit">编辑</view>
    </view>
  </view>

  <view class="add" bindtap="onAdd">+ 新增收货地址</view>
</view>
