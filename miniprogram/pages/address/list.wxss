page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.tip-top {
  font-size: 26rpx;
  color: #8a8a8a;
  padding: 0 8rpx 16rpx;
}

.empty {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 72rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: #1a1a1a;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9a9a9a;
}

.group {
  margin-bottom: 24rpx;
}

.group-name {
  font-size: 24rpx;
  color: #9a9a9a;
  padding: 0 8rpx 12rpx;
}

.addr {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
}

.addr-main {
  flex: 1;
  min-width: 0;
}

.addr-line1 {
  display: flex;
  align-items: center;
}

.contact {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.tag {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #d97600;
  background: #fff3e0;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.addr-line2 {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4a4a4a;
  line-height: 1.5;
}

.addr-pending {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a86b00;
}

.addr-reject {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #d93026;
}

/* 不可用的地址置灰保留：藏起来用户只会重新录一条一模一样的 */
.addr-off {
  background: #f2f3f5;
}

.addr-off .contact,
.addr-off .phone,
.addr-off .addr-line2 {
  color: #9a9a9a;
}

.addr-off-reason {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a86b00;
}

.addr-edit {
  font-size: 24rpx;
  color: #8a8a8a;
  padding-left: 20rpx;
}

.add {
  height: 96rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #ff9f1c;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}
