page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.tip {
  font-size: 24rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.row:last-child {
  border-bottom: none;
}

.row-column {
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx 0;
}

.label {
  width: 150rpx;
  font-size: 28rpx;
  color: #6a6a6a;
  flex-shrink: 0;
}

/* 必填星号：手机号为必填项（需求 4.8） */
.req {
  color: #e54d42;
  margin-left: 4rpx;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.value-ph {
  color: #b0b0b0;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.ph {
  color: #b0b0b0;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  height: 140rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
}

.arrow {
  font-size: 34rpx;
  color: #c8c8c8;
  padding-left: 12rpx;
}

.tags {
  display: flex;
}

.tag {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #6a6a6a;
}

.tag-active {
  background: #fff3e0;
  color: #d97600;
}

.save {
  margin-top: 40rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-disabled {
  background: #e6e6e6;
  color: #a8a8a8;
}
