page {
  background: #f5f6f8;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff1e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 26rpx;
  color: #d98410;
  font-weight: 600;
}

.title {
  margin-top: 40rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.desc {
  margin-top: 24rpx;
  font-size: 27rpx;
  color: #8a8a8a;
  line-height: 1.75;
  text-align: center;
}

.form-card {
  width: 100%;
  margin-top: 56rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 34rpx;
  letter-spacing: 6rpx;
  color: #1a1a1a;
}

.form-placeholder {
  font-size: 28rpx;
  letter-spacing: 0;
  color: #bbbbbb;
}

.submit-btn {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #ffd399;
  color: #ffffff;
}

.tips {
  margin-top: 40rpx;
}

.tips-line {
  font-size: 24rpx;
  color: #a8a8a8;
  line-height: 1.8;
  text-align: center;
}
