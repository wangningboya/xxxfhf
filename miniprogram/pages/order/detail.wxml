<view class="page" wx:if="{{order}}">
  <view class="status-card">
    <view class="status-label">{{order.statusLabel}}</view>
    <view class="status-pay">收款：{{order.payStatusLabel}}</view>
    <view class="status-code" wx:if="{{order.pickupCode && (order.status === 'accepted' || order.status === 'making' || order.status === 'ready')}}">
      取餐码 {{order.pickupCode}}
    </view>
  </view>

  <view class="alert" wx:if="{{order.status === 'rejected' && order.rejectReason}}">
    <view class="alert-title">商家拒单</view>
    <view class="alert-desc">{{order.rejectReason}}</view>
  </view>

  <view class="alert" wx:if="{{order.cancelRequested}}">
    <view class="alert-title">取消申请已提交</view>
    <view class="alert-desc">等商家处理，同意后份数会自动释放。</view>
  </view>

  <view class="alert alert-warn" wx:if="{{order.stockReleased}}">
    <view class="alert-title">份数已被释放</view>
    <view class="alert-desc">超过付款时限未确认收款，份数已放回，商家可能已无余量。</view>
  </view>

  <view class="card">
    <view class="card-title">供餐日 {{order.serveDate}}</view>
    <view class="item" wx:for="{{lines}}" wx:key="name">
      <view class="item-main">
        <view class="item-name">{{item.name}} <text class="item-qty">×{{item.qty}}</text></view>
        <view class="item-sub" wx:if="{{item.dishesText}}">{{item.dishesText}}</view>
        <view class="item-sub" wx:if="{{item.specText}}">{{item.specText}}</view>
      </view>
      <view class="item-price">¥{{item.priceText}}</view>
    </view>
  </view>

  <view class="card">
    <view class="sum-row"><text>商品金额</text><text>¥{{goodsText}}</text></view>
    <view class="sum-row" wx:if="{{order.specAmount}}"><text>规格差价</text><text>¥{{specText}}</text></view>
    <view class="sum-row" wx:if="{{order.deliveryFee}}"><text>配送费</text><text>¥{{feeText}}</text></view>
    <view class="sum-row sum-total"><text>合计</text><text class="sum-amount">¥{{totalText}}</text></view>
  </view>

  <view class="card">
    <view class="sum-row"><text>取送方式</text><text>{{order.deliveryType === 'delivery' ? '配送' : '自取'}}</text></view>
    <view class="sum-row" wx:if="{{order.pickupSlot}}"><text>取餐时段</text><text>{{order.pickupSlot}}</text></view>
    <block wx:if="{{order.address}}">
      <view class="sum-row"><text>收货地址</text><text>{{order.address.regionName}} {{order.address.detail}}</text></view>
      <view class="sum-row"><text>联系人</text><text>{{order.address.contactName}} {{order.address.phone}}</text></view>
    </block>
    <view class="sum-row" wx:if="{{order.remark}}"><text>备注</text><text>{{order.remark}}</text></view>
    <view class="sum-row" bindtap="onCopyOrderNo"><text>订单号</text><text>{{order.orderNo}}</text></view>
  </view>

  <view class="bottom-gap"></view>

  <view class="bottom-bar">
    <view class="btn btn-ghost" wx:if="{{order.status === 'pending_accept' && !order.cancelRequested}}" bindtap="onCancel">
      取消订单
    </view>
    <view
      class="btn"
      wx:if="{{order.payStatus === 'unpaid' && order.status !== 'cancelled' && order.status !== 'rejected'}}"
      bindtap="onClaimPaid"
    >
      我已完成付款
    </view>
  </view>
</view>
