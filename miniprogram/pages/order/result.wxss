page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.hero {
  padding: 40rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.6;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.row-label {
  font-size: 26rpx;
  color: #8a8a8a;
}

.row-value {
  font-size: 28rpx;
  color: #1a1a1a;
}

.row-code {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff9f1c;
  letter-spacing: 8rpx;
}

.row-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8442e;
}

.qr-card {
  text-align: center;
}

.qr {
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto;
  background: #f5f6f8;
  border-radius: 12rpx;
}

.qr-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.claim {
  margin-top: 32rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.claim-done {
  background: #f0f1f3;
  color: #8a8a8a;
}

.actions {
  display: flex;
  margin-top: 8rpx;
}

.action {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.action:first-child {
  margin-left: 0;
}

.action-ghost {
  background: #ffffff;
  color: #4a4a4a;
  border: 1rpx solid #e6e6e6;
}
