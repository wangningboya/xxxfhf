<view class="page">
  <view class="hero">
    <view class="hero-title">下单成功</view>
    <view class="hero-desc">请按下方收款码转账，转完点一下「我已完成转账」</view>
  </view>

  <view class="card" wx:if="{{order}}">
    <view class="row">
      <text class="row-label">订单号</text>
      <text class="row-value">{{order.orderNo}}</text>
    </view>
    <view class="row">
      <text class="row-label">供餐日</text>
      <text class="row-value">{{order.serveDate}}</text>
    </view>
    <view class="row" wx:if="{{order.pickupCode}}">
      <text class="row-label">取餐码</text>
      <text class="row-code">{{order.pickupCode}}</text>
    </view>
    <view class="row" wx:if="{{order.pickupSlot}}">
      <text class="row-label">取餐时段</text>
      <text class="row-value">{{order.pickupSlot}}</text>
    </view>
    <view class="row">
      <text class="row-label">应付金额</text>
      <text class="row-amount">¥{{totalText}}</text>
    </view>
  </view>

  <view class="card qr-card" wx:if="{{payQrCode}}">
    <view class="card-title">转账收款码</view>
    <image class="qr" src="{{payQrCode}}" mode="aspectFit" bindtap="onPreviewQr" />
    <view class="qr-hint">长按或点击放大后识别</view>

    <view class="claim {{claimed ? 'claim-done' : ''}}" bindtap="onClaimPaid">
      {{claimed ? '已告诉商家，等核对' : (claiming ? '提交中…' : '我已完成转账')}}
    </view>
  </view>

  <view class="card" wx:else>
    <view class="card-title">商家还没配收款码</view>
    <view class="qr-hint">请直接联系商家转账，转完告诉他订单号。</view>
  </view>

  <view class="actions">
    <view class="action action-ghost" bindtap="onBackToMenu">继续点餐</view>
    <view class="action" bindtap="onOpenOrder">查看订单</view>
  </view>
</view>
