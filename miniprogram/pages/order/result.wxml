<view class="page">
  <view class="hero">
    <view class="hero-title">下单成功</view>
    <view class="hero-desc">请按页面说明完成付款，付好后点一下「我已完成付款」</view>
  </view>

  <view class="card" wx:if="{{order}}">
    <view class="row">
      <text class="row-label">订单号</text>
      <text class="row-value">{{order.orderNo}}</text>
    </view>
    <view class="row">
      <text class="row-label">供餐日</text>
      <text class="row-value">{{order.serveDate}}</text>
    </view>
    <!-- 刚下单是「待接单」，取餐码要等商家出餐才展示，见订单详情；配送单不展示码 -->
    <view
      class="row"
      wx:if="{{order.pickupCode && order.deliveryType === 'pickup' && (order.status === 'ready' || order.status === 'completed')}}"
    >
      <text class="row-label">取餐码</text>
      <text class="row-code">{{order.pickupCode}}</text>
    </view>
    <view class="row" wx:if="{{order.pickupSlot}}">
      <text class="row-label">取餐时段</text>
      <text class="row-value">{{order.pickupSlot}}</text>
    </view>
    <!-- 自取单必须告诉用户去哪取：商家填了自取点才渲染，留空不占位 -->
    <view
      class="row"
      wx:if="{{order.deliveryType === 'pickup' && shopAddress}}"
      bindlongpress="onCopyAddress"
    >
      <text class="row-label">取餐点</text>
      <text class="row-value row-address">{{shopAddress}}</text>
    </view>
    <view class="row">
      <text class="row-label">应付金额</text>
      <text class="row-amount">¥{{totalText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">付款方式</view>
    <view class="pay-note">本店只收线下转账或现金。转账请联系商家获取收款账号；现金请取餐或送达时当面支付。付好后点下面的按钮。</view>

    <!-- 付款说明里让用户「联系商家」，这里就必须真的点得动 -->
    <view class="call-line" wx:if="{{shopPhone}}" bindtap="onCallShop">
      <text class="call-text">联系商家：{{shopPhone}}</text>
      <text class="call-btn">拨号</text>
    </view>

    <view class="claim {{claimed ? 'claim-done' : ''}}" bindtap="onClaimPaid">
      {{claimed ? '已告诉商家，等核对' : (claiming ? '提交中…' : '我已完成付款')}}
    </view>
  </view>

  <view class="actions">
    <view class="action action-ghost" bindtap="onBackToMenu">继续点餐</view>
    <view class="action" bindtap="onOpenOrder">查看订单</view>
  </view>
</view>
