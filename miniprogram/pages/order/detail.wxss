page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.status-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.status-label {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.status-pay {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.status-code {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #ff9f1c;
  letter-spacing: 12rpx;
}

.alert {
  background: #fdecec;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #c0392b;
}

.alert-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #c0392b;
  line-height: 1.6;
}

.alert-warn {
  background: #fff8e6;
}

.alert-warn .alert-title,
.alert-warn .alert-desc {
  color: #a86b00;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.item-qty {
  font-size: 24rpx;
  color: #9a9a9a;
}

.item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
  line-height: 1.5;
}

.item-price {
  font-size: 28rpx;
  color: #1a1a1a;
  padding-left: 20rpx;
}

.sum-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #6a6a6a;
  padding: 12rpx 0;
}

.sum-row text:last-child {
  max-width: 460rpx;
  text-align: right;
  color: #1a1a1a;
}

.sum-total {
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 28rpx;
  color: #1a1a1a;
}

.sum-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8442e;
}

.qr {
  width: 380rpx;
  height: 380rpx;
  margin: 0 auto;
  background: #f5f6f8;
  border-radius: 12rpx;
  display: block;
}

.qr-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9a9a9a;
  text-align: center;
}

.bottom-gap {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.btn:first-child {
  margin-left: 0;
}

.btn-ghost {
  background: #ffffff;
  color: #4a4a4a;
  border: 1rpx solid #e6e6e6;
}
