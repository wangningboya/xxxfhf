page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.type-row {
  display: flex;
}

.type {
  flex: 1;
  height: 76rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
  color: #4a4a4a;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.type:last-child {
  margin-right: 0;
}

.type-active {
  background: #fff3e0;
  color: #d97600;
  font-weight: 600;
}

.slot-wrap {
  margin-top: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-bottom: 16rpx;
}

.slots {
  display: flex;
  flex-wrap: wrap;
}

.slot {
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #4a4a4a;
  border: 1rpx solid #f5f6f8;
}

.slot-active {
  background: #fff3e0;
  border-color: #ff9f1c;
  color: #d97600;
}

.hint {
  font-size: 24rpx;
  color: #b0b0b0;
}

.addr {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 0 4rpx;
  border-top: 1rpx solid #f2f3f5;
}

.addr-body {
  flex: 1;
}

.addr-line1 {
  font-size: 30rpx;
  color: #1a1a1a;
}

.addr-line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.addr-empty {
  flex: 1;
  font-size: 28rpx;
  color: #b0b0b0;
}

.arrow {
  font-size: 34rpx;
  color: #c8c8c8;
  padding-left: 16rpx;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.item-spec {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
}

.item-qty {
  width: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8a;
}

.item-amount {
  width: 140rpx;
  text-align: right;
  font-size: 28rpx;
  color: #1a1a1a;
}

.remark {
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.remark-ph {
  color: #b0b0b0;
  font-size: 26rpx;
}

.sum-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #6a6a6a;
  padding: 10rpx 0;
}

.sum-total {
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 28rpx;
  color: #1a1a1a;
}

.sum-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8442e;
}

.pay-hint {
  font-size: 24rpx;
  color: #9a9a9a;
  line-height: 1.6;
  padding: 0 8rpx;
}

.bottom-gap {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #8a8a8a;
}

.total-amount {
  margin-left: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #e8442e;
}

.submit {
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: 42rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
}

.submit-disabled {
  background: #e6e6e6;
  color: #a8a8a8;
}

/* 截单失效提示（需求 4.6） */
.cutoff-banner {
  background: #fff8e6;
  color: #a86b00;
  font-size: 26rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
