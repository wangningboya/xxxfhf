<view class="page">
  <view class="cutoff-banner" wx:if="{{cutoff}}">该菜单已截单，无法提交，请返回重新选餐</view>

  <view class="card">
    <view class="card-title">取餐方式</view>
    <view class="type-row">
      <view
        class="type {{deliveryType === 'pickup' ? 'type-active' : ''}}"
        data-type="pickup"
        bindtap="onSwitchType"
      >
        自取
      </view>
      <view
        class="type {{deliveryType === 'delivery' ? 'type-active' : ''}}"
        data-type="delivery"
        bindtap="onSwitchType"
      >
        配送
      </view>
    </view>

    <!-- 自取：时段来自商家配置，不能自由填 -->
    <view class="slot-wrap" wx:if="{{deliveryType === 'pickup'}}">
      <view class="field-label">取餐时段</view>
      <view class="slots" wx:if="{{pickupSlots.length}}">
        <view
          class="slot {{pickupSlot === item ? 'slot-active' : ''}}"
          wx:for="{{pickupSlots}}"
          wx:key="*this"
          data-slot="{{item}}"
          bindtap="onPickSlot"
        >
          {{item}}
        </view>
      </view>
      <view class="hint" wx:else>商家还没有配置取餐时段，请联系商家</view>
    </view>

    <!-- 配送：地址 -->
    <view class="addr" wx:if="{{deliveryType === 'delivery'}}" bindtap="onOpenAddress">
      <view class="addr-body" wx:if="{{address}}">
        <view class="addr-line1">{{address.regionName}} {{address.detail}}</view>
        <view class="addr-line2">{{address.contactName}} {{address.phone}}</view>
      </view>
      <view class="addr-empty" wx:else>请联系商家添加收货地址</view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">供餐日 {{serveDate}}</view>
    <view class="item" wx:for="{{lines}}" wx:key="key">
      <view class="item-main">
        <view class="item-name">{{item.name}}</view>
        <view class="item-spec" wx:if="{{item.specText}}">{{item.specText}}</view>
      </view>
      <view class="item-qty">×{{item.qty}}</view>
      <view class="item-amount">¥{{item.lineText}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">备注</view>
    <input
      class="remark"
      value="{{remark}}"
      placeholder="口味、忌口等，商家能看到"
      placeholder-class="remark-ph"
      maxlength="100"
      bindinput="onRemarkInput"
    />
  </view>

  <view class="card">
    <view class="sum-row">
      <text>商品金额</text>
      <text>¥{{goodsAmountText}}</text>
    </view>
    <view class="sum-row" wx:if="{{deliveryType === 'delivery'}}">
      <text>配送费</text>
      <text>¥{{deliveryFeeText}}</text>
    </view>
    <view class="sum-row sum-total">
      <text>合计</text>
      <text class="sum-amount">¥{{totalAmountText}}</text>
    </view>
  </view>

  <view class="pay-hint">提交后按订单页说明付款（线下转账或现金），付好后点「我已完成付款」</view>

  <view class="bottom-gap"></view>

  <view class="bottom-bar">
    <view class="total">
      <text class="total-label">共 {{count}} 份</text>
      <text class="total-amount">¥{{totalAmountText}}</text>
    </view>
    <view
      class="submit {{canSubmit && !submitting ? '' : 'submit-disabled'}}"
      bindtap="onSubmit"
    >
      {{submitting ? '提交中…' : '提交订单'}}
    </view>
  </view>
</view>
