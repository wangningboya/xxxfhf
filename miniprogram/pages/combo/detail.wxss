page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/*
 * 封面 + 月销量角标的定位容器。
 * 外边距从 .cover 挪到这里：容器开了 overflow:hidden，图片自带的 margin 会被裁掉一截。
 */
.cover-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cover {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background: #eceef1;
}

.cover-wrap .cover {
  display: block;
  height: 100%;
  border-radius: 0;
}

.cover-wrap .cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 全宽大图上 20rpx 太小，单独放一档 */
.cover-wrap .sold-badge {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b0b0;
  font-size: 26rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.price {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8442e;
}

.dishes {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.6;
}

.remain {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b0b0b0;
}

/* 已订 M / 共 N 的进度条：满格即售罄，满格时填充转灰 */
.stock-bar {
  height: 10rpx;
  margin-top: 10rpx;
  border-radius: 5rpx;
  background: #f2f2f2;
  overflow: hidden;
}

.stock-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: #ff9f1c;
}

.stock-bar-fill-done {
  background: #d9d9d9;
}

.group-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.group-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.group-tag {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
}

.option {
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
  color: #4a4a4a;
  border: 1rpx solid #f5f6f8;
}

.option-active {
  background: #fff3e0;
  border-color: #ff9f1c;
  color: #d97600;
}

.option-delta {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #b0b0b0;
}

.option-active .option-delta {
  color: #d97600;
}

.qty-row {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-label {
  font-size: 30rpx;
  color: #1a1a1a;
}

.stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f1f3;
  color: #4a4a4a;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-disabled {
  color: #c8c8c8;
}

.step-value {
  min-width: 72rpx;
  text-align: center;
  font-size: 30rpx;
}

.bottom-gap {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #8a8a8a;
}

.total-amount {
  margin-left: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #e8442e;
}

.add-btn {
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: 42rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
}

.add-btn-disabled {
  background: #e6e6e6;
  color: #a8a8a8;
}
