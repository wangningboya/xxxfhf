<view class="page">
  <!-- 通知横栏：左侧轮播未读（最多 3 条），右侧铃铛进消息中心。
       铃铛常驻 —— 没有未读时它是进消息中心看历史的唯一入口 -->
  <view class="notice-bar">
    <view class="notice-main" bindtap="onOpenMessages">
      <swiper
        class="notice-swiper"
        wx:if="{{noticeItems.length}}"
        vertical
        circular="{{noticeItems.length > 1}}"
        autoplay="{{noticeItems.length > 1}}"
        interval="3000"
        duration="400"
      >
        <swiper-item wx:for="{{noticeItems}}" wx:key="id">
          <view class="notice-line">
            <text class="notice-title">{{item.title}}</text>
            <text class="notice-text">{{item.content}}</text>
          </view>
        </swiper-item>
      </swiper>
      <view class="notice-line" wx:elif="{{shopNotice}}">
        <text class="notice-title">公告</text>
        <text class="notice-text">{{shopNotice}}</text>
      </view>
      <view class="notice-line" wx:else>
        <text class="notice-text notice-empty">暂无新消息</text>
      </view>
    </view>
    <view class="notice-bell" bindtap="onOpenMessages">
      <text class="bell-icon">🔔</text>
      <text class="bell-badge" wx:if="{{unreadCount > 0}}">{{unreadBadge}}</text>
    </view>
  </view>

  <!-- 订单状态条：明天那笔还在进行中的单，没有就不渲染 -->
  <view class="order-bar" wx:if="{{orderBar}}" bindtap="onOpenOrder">
    <view class="order-bar-main">
      <view class="order-bar-title">明天的午餐 · {{orderBar.qty}} 份</view>
      <view class="order-bar-sub">{{orderBar.summary}}</view>
    </view>
    <view class="order-bar-tag {{orderBar.tagClass}}">{{orderBar.statusLabel}}</view>
  </view>

  <!-- 店招：公告只在顶部通知栏显示一处，这里只留店名与欢迎语 -->
  <view class="hero">
    <view class="hero-name">{{shopName}}</view>
    <view class="hero-welcome">欢迎光临，今天想吃点什么</view>
  </view>

  <!-- 明日菜单预览：横向滑动，字段与点餐页同口径；停业或空菜单不渲染 -->
  <view class="menu-preview" wx:if="{{previewItems.length}}">
    <view class="preview-head">
      <text class="preview-title">明日菜单（{{serveDate}}）</text>
      <text class="preview-hint">点击查看详情</text>
    </view>
    <scroll-view class="preview-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        class="preview-card {{item.soldOut ? 'preview-soldout' : ''}}"
        wx:for="{{previewItems}}"
        wx:key="comboId"
        data-id="{{item.comboId}}"
        bindtap="onOpenCombo"
      >
        <image class="preview-cover" src="{{item.coverUrl}}" mode="aspectFill" wx:if="{{item.coverUrl}}"></image>
        <view class="preview-cover preview-cover-empty" wx:else>
          <text>暂无图</text>
        </view>
        <view class="preview-name">{{item.name}}</view>
        <view class="preview-meta">
          <text class="preview-price">{{item.priceText}}</text>
          <text class="preview-remain">{{item.stockText}}</text>
        </view>
        <view class="preview-stock" wx:if="{{!item.unlimited}}">
          <view
            class="preview-stock-fill {{item.soldOut ? 'preview-stock-fill-done' : ''}}"
            style="width: {{item.stockPercent}}%"
          ></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 营业状态：取次日菜单，与点餐页同源 -->
  <view class="status-card">
    <view class="status-row">
      <text class="status-label">明日营业</text>
      <text class="status-value {{statusWarn ? 'status-warn' : ''}}">{{statusText || '读取中…'}}</text>
    </view>
    <view class="status-row" wx:if="{{serveTimeText}}">
      <text class="status-label">供餐时段</text>
      <text class="status-value">{{serveTimeText}}</text>
    </view>
    <view class="status-row" wx:if="{{cutoffTime}}">
      <text class="status-label">截单时间</text>
      <text class="status-value">前一天 {{cutoffTime}}</text>
    </view>
    <view class="status-row" wx:if="{{shopAddress}}" bindlongpress="onCopyAddress">
      <text class="status-label">自取点</text>
      <text class="status-value status-address">{{shopAddress}}</text>
    </view>
    <view class="status-row" wx:if="{{shopPhone}}" bindtap="onCallShop">
      <text class="status-label">联系商家</text>
      <text class="status-value status-phone">{{shopPhone}} 拨号</text>
    </view>
  </view>

  <view class="start-btn {{loading ? 'start-btn-disabled' : ''}}" bindtap="onStartOrder">
    {{loading ? '加载中…' : '开始点餐'}}
  </view>

  <!-- 悬浮购物车球：车里有货才出现，样式与点餐页同款（需求 4.5 / D-15） -->
  <view class="cart-fab" wx:if="{{cartCount > 0}}" bindtap="onOpenCart">
    <image class="cart-fab-icon" src="/assets/tabbar/cart.png" mode="aspectFit" />
    <view class="cart-fab-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
  </view>

  <!-- 预留位：后续推销位叠在这里，本期不渲染任何内容 -->
</view>
