page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 通知横栏 ---------- */

.notice-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 20rpx 0 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-swiper {
  width: 100%;
  height: 76rpx;
}

.notice-line {
  display: flex;
  align-items: center;
  height: 76rpx;
  overflow: hidden;
}

.notice-title {
  flex: none;
  max-width: 220rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ff9f1c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #666666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-empty {
  color: #b0b0b0;
}

.notice-bell {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding-left: 20rpx;
}

.bell-icon {
  font-size: 34rpx;
  line-height: 1;
}

.bell-badge {
  position: absolute;
  top: 10rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

/* ---------- 店招 ---------- */

.hero {
  background: linear-gradient(135deg, #ffb347 0%, #ff9f1c 100%);
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  margin-bottom: 24rpx;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.hero-notice {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #fff6e8;
  line-height: 1.6;
}

.hero-notice-empty {
  color: #fff0d9;
}

/* ---------- 营业状态 ---------- */

.status-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  margin-bottom: 32rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.status-row:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: #8a8a8a;
}

.status-value {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  text-align: right;
  max-width: 60%;
}

.status-warn {
  color: #a86b00;
}

.status-address {
  max-width: 66%;
  font-weight: 500;
  line-height: 1.5;
}

.status-phone {
  color: #ff9f1c;
}

/* ---------- 主按钮 ---------- */

.start-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
}

.start-btn-disabled {
  background: #e6e6e6;
  color: #a8a8a8;
}

/* ---------- 说明 ---------- */

.tips {
  margin-top: 40rpx;
  padding: 0 8rpx;
}

.tips-line {
  font-size: 24rpx;
  color: #9a9a9a;
  line-height: 1.9;
}
