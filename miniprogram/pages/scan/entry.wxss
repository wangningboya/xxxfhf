/* 落地页只有一个转圈和一句提示，居中压白底，不要在扫码后闪一下别的颜色 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #f0f0f0;
  border-top-color: #ff9f1c;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 50%;
  border: 3rpx solid #ff9f1c;
  color: #ff9f1c;
  font-size: 48rpx;
  font-weight: 600;
}

.tip {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
}

.btns {
  display: flex;
  margin-top: 48rpx;
}

.btn {
  min-width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  margin: 0 16rpx;
}

.btn.ghost {
  background: #ffffff;
  color: #666666;
  border: 2rpx solid #dddddd;
}
