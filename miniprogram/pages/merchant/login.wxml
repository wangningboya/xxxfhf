<view class="page">
  <view class="hero">
    <view class="hero-title">商家登录</view>
    <view class="hero-desc">用商家账号登录，管理接单、备菜与菜单</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">账号</text>
      <input
        class="field-input"
        value="{{username}}"
        data-field="username"
        placeholder="商家账号"
        placeholder-class="ph"
        maxlength="64"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password
        value="{{password}}"
        data-field="password"
        placeholder="密码"
        placeholder-class="ph"
        maxlength="64"
        bindinput="onInput"
      />
    </view>
  </view>

  <view class="btn login {{submitting ? 'btn-disabled' : ''}}" bindtap="onLogin">
    {{submitting ? '登录中…' : '登录'}}
  </view>

  <view class="back" bindtap="onBackToCustomer">返回点餐首页</view>
</view>
