@import "./merchant.wxss";

.conn {
  display: flex;
  align-items: center;
  padding: 8rpx 0 16rpx;
}

.conn-state {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.conn-on {
  background: #eaf7ee;
  color: #2e9e5b;
}

.conn-off {
  background: #f2f3f5;
  color: #8a8a8a;
}

.conn-name {
  font-size: 30rpx;
  color: #1a1a1a;
  flex: 1;
  word-break: break-all;
}

.note {
  font-size: 22rpx;
  color: #9a9a9a;
  line-height: 1.6;
  padding: 4rpx 0 8rpx;
}

.actions {
  display: flex;
  margin-top: 12rpx;
}

.actions .btn {
  flex: 1;
  margin-right: 16rpx;
}

.actions .btn:last-child {
  margin-right: 0;
}

.scan-tip {
  font-size: 24rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
}

.device {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.device:last-child {
  border-bottom: none;
}

.device-main {
  flex: 1;
  min-width: 0;
}

.device-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.device-id {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
  word-break: break-all;
}

.device-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: #fff3e0;
  color: #d97600;
  font-size: 26rpx;
}

.sub-title {
  font-size: 26rpx;
  color: #6a6a6a;
  padding: 16rpx 0 12rpx;
}

.cell {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.cell:last-child {
  border-bottom: none;
}

.cell-main {
  flex: 1;
}

.cell-title {
  font-size: 28rpx;
  color: #1a1a1a;
}

.cell-desc {
  font-size: 22rpx;
  color: #9a9a9a;
  line-height: 1.6;
  margin-top: 6rpx;
}

.cell-hint {
  color: #d97600;
}

.cell-arrow {
  color: #c0c0c0;
  font-size: 34rpx;
  margin-left: 16rpx;
}

.tip {
  font-size: 22rpx;
  color: #b0b0b0;
  text-align: center;
  padding: 8rpx 0 40rpx;
}

/* 进度层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.progress-text {
  font-size: 36rpx;
  color: #1a1a1a;
  text-align: center;
  margin: 24rpx 0 20rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f2f3f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #ff9f1c;
  border-radius: 6rpx;
  transition: width 0.2s;
}

.dialog-msg {
  font-size: 24rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 24rpx;
  line-height: 1.5;
}

.dialog-actions {
  display: flex;
  margin-top: 32rpx;
}

.dialog-actions .btn {
  flex: 1;
  margin-right: 16rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.dialog-actions .btn:last-child {
  margin-right: 0;
}

/* canvas 必须真实存在但不可见：SDK 只在真实画布上取像素 */
.print-canvas {
  position: fixed;
  left: 100%;
  top: 0;
}
