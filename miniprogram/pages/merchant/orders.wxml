<view class="page">
  <view class="filters">
    <picker mode="date" value="{{serveDate}}" bindchange="onDateChange">
      <view class="date-pick">{{serveDate}} ▾</view>
    </picker>
    <view class="search">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜昵称 / 手机号"
        placeholder-class="ph"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
    </view>
  </view>

  <!-- 只看退订：从工作台「待处理退订」点进来时默认开启，此时不限供餐日，往期漏单也能捞到 -->
  <view class="cancel-filter {{cancelOnly ? 'cancel-filter-on' : ''}}" bindtap="onToggleCancelOnly">
    <text>{{cancelOnly ? '✓ ' : ''}}只看有退订申请的单</text>
    <text class="cancel-filter-hint">{{cancelOnly ? '（不限供餐日）' : ''}}</text>
  </view>

  <!-- 打印模式：勾选规则换成「所有能打的单」，因为补打常发生在已接单/已出餐的订单上 -->
  <view class="cancel-filter {{printMode ? 'cancel-filter-on' : ''}}" bindtap="onTogglePrintMode">
    <text>{{printMode ? '✓ ' : ''}}打印标签模式</text>
    <text class="cancel-filter-hint">{{printMode ? '（可选已接单的订单）' : ''}}</text>
  </view>

  <scroll-view class="tabs" scroll-x enable-flex>
    <view
      class="tab {{status === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSwitchTab"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <view class="empty-title">这一天没有符合条件的订单</view>
    <view class="empty-desc">换个日期或状态看看</view>
  </view>

  <view
    class="order {{item.stockReleased ? 'order-warn' : ''}}"
    wx:for="{{list}}"
    wx:key="orderId"
    data-id="{{item.orderId}}"
    bindtap="onOpen"
  >
    <view class="order-head">
      <view
        class="check {{selected[item.orderId] ? 'check-on' : ''}} {{(printMode ? item.printable : item.selectable) ? '' : 'check-off'}}"
        data-id="{{item.orderId}}"
        data-selectable="{{printMode ? item.printable : item.selectable}}"
        catchtap="onToggle"
      >
        {{selected[item.orderId] ? '✓' : ''}}
      </view>
      <view class="order-name">{{item.userNickName}}</view>
      <view class="order-status {{item.tagClass}}">{{item.statusLabel}}</view>
    </view>

    <view class="order-summary">{{item.summary}}</view>

    <!-- 备注：后厨与配送要按这句话做，不能只在用户端显示 -->
    <view class="order-remark" wx:if="{{item.remark}}">
      <text class="remark-tag">备注</text>
      <text class="remark-text">{{item.remark}}</text>
    </view>

    <view class="order-meta">
      <text>{{item.orderNo}}</text>
      <text wx:if="{{item.pickupCode}}"> · 码 {{item.pickupCode}}</text>
      <text wx:if="{{item.pickupSlot}}"> · {{item.pickupSlot}}</text>
      <text wx:if="{{item.deliveryType === 'delivery'}}"> · 配送到 {{item.regionName}}</text>
      <text wx:else> · 自取</text>
    </view>

    <view class="badges">
      <text class="badge badge-red" wx:if="{{item.stockReleased}}">份数已释放</text>
      <text class="badge badge-warn" wx:if="{{item.cancelRequested}}">用户申请取消</text>
      <!-- 打印三态：A×2 只出 1 张时是「部分 1/2」而不是「已打」，少一张就是少一份饭 -->
      <text class="badge {{item.printState === 'done' ? 'badge-done' : 'badge-warn'}}" wx:if="{{item.printState !== 'none'}}">{{item.printText}}</text>
      <text class="badge">{{item.payStatusLabel}}</text>
    </view>

    <view class="order-foot">
      <text class="order-phone" wx:if="{{item.userPhone}}">{{item.userPhone}}</text>
      <text class="order-amount">¥{{item.totalText}}</text>
    </view>
  </view>

  <view class="tip" wx:if="{{loading}}">加载中…</view>
  <view class="tip" wx:elif="{{finished && list.length}}">没有更多了</view>

  <view class="bottom-gap" wx:if="{{selectedCount > 0}}"></view>
  <view class="bottom-bar" wx:if="{{selectedCount > 0}}">
    <view class="btn btn-ghost" bindtap="onSelectAll">全选 / 取消</view>
    <!-- 打印模式下只出打印按钮：这时勾的可能是已接单的单，摆在接单旁边迟早点错 -->
    <block wx:if="{{printMode}}">
      <view class="btn {{printLoading ? 'btn-disabled' : ''}}" bindtap="onBatchPrint">
        {{printLoading ? '取数据…' : printText}}
      </view>
    </block>
    <block wx:else>
      <view class="btn btn-danger reject" bindtap="onBatchReject">
        {{rejecting ? '处理中…' : rejectText}}
      </view>
      <view class="btn accept" bindtap="onAccept">
        {{accepting ? '处理中…' : acceptText}}
      </view>
    </block>
  </view>
</view>

<!-- 打印进度层：打印期间必须留在页面上，切后台会丢数据 -->
<view class="mask" wx:if="{{printing}}">
  <view class="dialog">
    <view class="dialog-title">{{paused ? '打印机暂停' : '正在打印'}}</view>
    <view class="progress-text">{{printedCount}} / {{totalCount}} 张</view>
    <view class="progress-bar"><view class="progress-inner" style="width:{{progressPercent}}%"></view></view>
    <view class="dialog-msg" wx:if="{{printError}}">{{printError}}</view>
    <view class="dialog-msg" wx:elif="{{paused}}">处理好后点「继续」，打印机会接着打。</view>
    <view class="dialog-msg" wx:else>打印期间不要切出小程序，切到后台会中断。</view>
    <view class="dialog-actions">
      <view class="btn btn-ghost" wx:if="{{paused}}" bindtap="onResumePrint">继续</view>
      <view class="btn btn-danger" bindtap="onCancelPrint">停止</view>
    </view>
  </view>
</view>

<!-- SDK 需要真实画布取像素，放在屏幕外但必须存在 -->
<view class="print-canvas">
  <canvas canvas-id="test" style="width:560px;height:320px;"></canvas>
</view>
