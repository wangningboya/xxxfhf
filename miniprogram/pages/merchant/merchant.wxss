/* 商家端公共样式。各页面 wxss 用 @import "./merchant.wxss"; 引入，避免每个页面抄一遍。 */

page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #6a6a6a;
}

.row-value {
  font-size: 28rpx;
  color: #1a1a1a;
  text-align: right;
  max-width: 440rpx;
}

.muted {
  color: #9a9a9a;
  font-size: 24rpx;
}

.empty {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 72rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: #1a1a1a;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9a9a9a;
}

.btn {
  height: 84rpx;
  border-radius: 42rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

.btn-ghost {
  background: #ffffff;
  color: #4a4a4a;
  border: 1rpx solid #e6e6e6;
}

.btn-disabled {
  background: #e6e6e6;
  color: #a8a8a8;
}

.btn-danger {
  background: #fdecec;
  color: #c0392b;
  border: 1rpx solid #f5c6c2;
}

/* 筛选标签容器：combos / dishes / users / combo-edit 共用 */
.chips {
  display: flex;
  flex-wrap: wrap;
}

/* 页面内提示条：菜单页与盒饭编辑页共用 */
.hint {
  font-size: 24rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.chip {
  padding: 10rpx 24rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 26rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #6a6a6a;
}

.chip-active {
  background: #fff3e0;
  color: #d97600;
}

.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f4f5f7;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 170rpx;
  font-size: 28rpx;
  color: #6a6a6a;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.ph {
  color: #b0b0b0;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.bottom-gap {
  height: 160rpx;
}
