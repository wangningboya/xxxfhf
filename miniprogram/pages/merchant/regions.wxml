<view class="page">
  <view wx:if="{{loading}}" class="empty"><view class="empty-title">加载中…</view></view>

  <view wx:for="{{regions}}" wx:key="id" class="card">
    <view class="row">
      <view>
        <view class="region-name">
          {{item.name}}
          <text class="badge {{item.status === 'enabled' ? 'badge-on' : ''}}">{{item.status === 'enabled' ? '启用' : '停用'}}</text>
        </view>
        <view class="muted" wx:if="{{item.remark}}">{{item.remark}}</view>
        <view class="muted">{{item.addressCount || 0}} 个地址</view>
      </view>
      <text class="muted">排序 {{item.sort || 0}}</text>
    </view>
    <view class="ops">
      <text class="op" data-index="{{index}}" bindtap="onEdit">改名</text>
      <text class="op" data-index="{{index}}" bindtap="onOpenAddresses">地址</text>
      <text class="op" data-index="{{index}}" bindtap="onToggle">{{item.status === 'enabled' ? '停用' : '启用'}}</text>
      <text class="op op-danger" data-index="{{index}}" bindtap="onDelete">删除</text>
    </view>
  </view>

  <!-- 区域下的地址清单：区域停用是判定相乘，地址本身不用逐条改，这里是给商家做个别处置的 -->
  <view wx:if="{{drawer}}" class="drawer-mask" bindtap="onCloseDrawer"></view>
  <view wx:if="{{drawer}}" class="drawer">
    <view class="drawer-head">
      <text class="drawer-title">「{{drawer.name}}」的地址</text>
      <text class="drawer-close" bindtap="onCloseDrawer">关闭</text>
    </view>
    <view class="drawer-hint">
      区域停用后，下面这些地址一律不能用于新配送单（已下的订单不受影响）。地址也能单独停用，两者互不干扰：区域恢复启用时，单独停用过的地址仍然是停用。
      <block wx:if="{{!canToggleAddress}}">你没有「用户地址维护」权限，这里只能看。</block>
    </view>
    <scroll-view scroll-y class="drawer-body">
      <view wx:if="{{drawerLoading}}" class="muted">加载中…</view>
      <view wx:if="{{!drawerLoading && drawerRows.length === 0}}" class="muted">这个区域下还没有地址</view>
      <view wx:for="{{drawerRows}}" wx:key="id" class="addr-row">
        <view class="addr-main">
          <view class="addr-name">
            {{item.contactName}}
            <text class="addr-phone">{{item.phone}}</text>
          </view>
          <view class="addr-detail">{{item.detail}}</view>
          <view class="addr-tags">
            <text class="badge {{item.status === 'active' ? 'badge-on' : ''}}">{{item.statusText}}</text>
            <text class="badge {{item.enabled ? 'badge-on' : ''}}">{{item.enabled ? '启用' : '停用'}}</text>
          </view>
          <view class="addr-off" wx:if="{{item.unusableText}}">{{item.unusableText}}</view>
        </view>
        <text
          wx:if="{{canToggleAddress}}"
          class="op"
          data-index="{{index}}"
          bindtap="onToggleAddress"
        >{{item.enabled ? '停用' : '启用'}}</text>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{!loading && regions.length === 0}}" class="empty">
    <view class="empty-title">还没有区域</view>
    <view class="empty-desc">先建区域，地址才能挂上去，备菜才能按区域汇总</view>
  </view>

  <!-- 表单 -->
  <view wx:if="{{form}}" class="card">
    <view class="card-title">{{form.id ? '编辑区域' : '新增区域'}}</view>
    <view class="field">
      <text class="field-label">名称</text>
      <input class="field-input" placeholder="如：A 栋 / 研发中心" placeholder-class="ph"
             value="{{form.name}}" data-key="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <input class="field-input" placeholder="可填范围说明（可不填）" placeholder-class="ph"
             value="{{form.remark}}" data-key="remark" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">排序</text>
      <input class="field-input" type="number" placeholder="数字越小越靠前" placeholder-class="ph"
             value="{{form.sort}}" data-key="sort" bindinput="onInput" />
    </view>
    <view class="form-ops">
      <view class="btn btn-ghost" bindtap="onCancel">取消</view>
      <view class="btn" bindtap="onSave">{{saving ? '保存中…' : '保存'}}</view>
    </view>
  </view>

  <view class="bottom-gap" wx:if="{{form}}"></view>
  <view class="bottom-bar" wx:if="{{!form}}">
    <view class="btn" bindtap="onNew">新增区域</view>
  </view>
</view>
