@import "./merchant.wxss";

.buckets {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.bucket {
  width: 48.5%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.bucket-on {
  border-color: #ff9f1c;
}

.bucket-label {
  font-size: 26rpx;
  color: #6a6a6a;
  margin-bottom: 10rpx;
}

.bucket-amount {
  font-size: 36rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.bucket-count {
  font-size: 24rpx;
  color: #d97600;
  margin-bottom: 6rpx;
}

.bucket-hint {
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 1.5;
}

.line {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.line:last-child {
  border-bottom: none;
}

.line-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.line-no {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.line-amount {
  font-size: 28rpx;
  color: #d97600;
}

/* 勾稽校验（v3.50）：账平时低调，不平时必须一眼看到 */
.check {
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 4rpx 0 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.check-ok {
  background: #f0f9eb;
  color: #529b2e;
}

.check-bad {
  background: #fdeceb;
  color: #c45656;
}

.check-diff {
  font-weight: 600;
  margin-top: 6rpx;
}

.check-note {
  font-weight: 400;
  margin-left: 8rpx;
  opacity: 0.85;
}

.check-rows {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.check-row {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  padding: 4rpx 0;
}
