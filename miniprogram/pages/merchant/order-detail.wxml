<view class="page" wx:if="{{order}}">
  <view class="card">
    <view class="head-row">
      <view class="name">{{row.userNickName || '群成员'}}</view>
      <view class="status">{{order.statusLabel}}</view>
    </view>
    <!-- 本单联系电话 = 下单时确认的收货电话（前 3 后 2）；拨号走「联系顾客」单独取一次全号，两处同源 -->
    <view class="meta" wx:if="{{row.contactPhone}}">📞 {{row.contactPhone}}</view>
    <view class="call-btn" wx:if="{{row.contactPhone}}" bindtap="onCallCustomer">联系顾客</view>
    <view class="meta" wx:else>📞 未留电话</view>
    <view class="meta">{{order.orderNo}}</view>
  </view>

  <view class="card" wx:if="{{order.stockReleased}}">
    <view class="warn-title">份数已被超时释放</view>
    <view class="warn-desc">这单可能已经没有余量了，接单前请确认。</view>
  </view>

  <view class="card" wx:if="{{order.cancelRequested}}">
    <view class="warn-title">用户申请取消</view>
    <view class="warn-desc" wx:if="{{order.cancelRequest && order.cancelRequest.reason}}">
      原因：{{order.cancelRequest.reason}}
    </view>
    <view class="handle">
      <view class="btn btn-danger" data-approve="true" bindtap="onHandleCancel">同意取消</view>
      <view class="btn btn-ghost" data-approve="false" bindtap="onHandleCancel">驳回申请</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">明细（供餐日 {{order.serveDate}}）</view>
    <view class="item" wx:for="{{lines}}" wx:key="name">
      <view class="item-main">
        <view class="item-name">{{item.name}} ×{{item.qty}}</view>
        <view class="item-sub" wx:if="{{item.dishesText}}">{{item.dishesText}}</view>
        <view class="item-sub" wx:if="{{item.specText}}">{{item.specText}}</view>
      </view>
      <view class="item-price">¥{{item.priceText}}</view>
    </view>
    <view class="total-row">
      <text>合计</text>
      <text class="total-amount">¥{{totalText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row"><text class="row-label">收款状态</text><text class="row-value">{{order.payStatusLabel}}</text></view>
    <view class="row"><text class="row-label">取送方式</text><text class="row-value">{{deliveryTypeText}}</text></view>
    <view class="row" wx:if="{{order.pickupSlot}}"><text class="row-label">取餐时段</text><text class="row-value">{{order.pickupSlot}}</text></view>
    <view class="row" wx:if="{{order.pickupCode}}"><text class="row-label">取餐码</text><text class="row-value code">{{order.pickupCode}}</text></view>
    <view class="row" wx:if="{{order.address}}"><text class="row-label">收货地址</text><text class="row-value">{{order.address.regionName}} {{order.address.detail}}</text></view>
    <view class="row" wx:if="{{order.remark}}"><text class="row-label">备注</text><text class="row-value">{{order.remark}}</text></view>
    <view class="row" wx:if="{{order.rejectReason}}"><text class="row-label">拒单原因</text><text class="row-value">{{order.rejectReason}}</text></view>
  </view>

  <view class="bottom-gap"></view>

  <view class="bottom-bar">
    <view
      class="btn"
      wx:if="{{order.status === 'pending_accept' && !order.cancelRequested}}"
      bindtap="onAccept"
    >
      接单
    </view>
    <view
      class="btn btn-ghost"
      wx:if="{{order.status === 'pending_accept' && !order.cancelRequested}}"
      bindtap="onReject"
    >
      拒单
    </view>
    <view class="btn" wx:if="{{nextStatus}}" bindtap="onAdvance">{{nextLabel}}</view>

    <view
      class="btn"
      wx:if="{{order.payStatus === 'unpaid' || order.payStatus === 'claimed'}}"
      bindtap="onConfirmPay"
    >
      确认收款
    </view>
    <view class="btn btn-ghost" wx:if="{{order.payStatus === 'paid'}}" bindtap="onRevertPay">
      回退收款
    </view>
    <view class="btn btn-danger" wx:if="{{order.payStatus === 'refunding'}}" bindtap="onRefund">
      标记已退款
    </view>
  </view>
</view>
