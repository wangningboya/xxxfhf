<view class="page" wx:if="{{order}}">
  <view class="card">
    <view class="head-row">
      <view class="name">{{row.userNickName || '群成员'}}</view>
      <view class="status">{{order.statusLabel}}</view>
    </view>
    <!-- 本单联系电话 = 下单时确认的收货电话（前 3 后 2）；拨号走「联系顾客」单独取一次全号，两处同源 -->
    <view class="meta" wx:if="{{row.contactPhone}}">📞 {{row.contactPhone}}</view>
    <view class="call-btn" wx:if="{{row.contactPhone}}" bindtap="onCallCustomer">联系顾客</view>
    <view class="meta" wx:else>📞 未留电话</view>
    <view class="meta">{{order.orderNo}}</view>
  </view>

  <view class="card" wx:if="{{order.stockReleased}}">
    <view class="warn-title">份数已被超时释放</view>
    <view class="warn-desc">这单可能已经没有余量了，接单前请确认。</view>
  </view>

  <view class="card" wx:if="{{order.cancelRequested}}">
    <view class="warn-title">用户申请取消</view>
    <view class="warn-desc" wx:if="{{order.cancelRequest && order.cancelRequest.reason}}">
      原因：{{order.cancelRequest.reason}}
    </view>
    <view class="handle">
      <view class="btn btn-danger" data-approve="true" bindtap="onHandleCancel">同意取消</view>
      <view class="btn btn-ghost" data-approve="false" bindtap="onHandleCancel">驳回申请</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">明细（供餐日 {{order.serveDate}}）</view>
    <view class="item" wx:for="{{lines}}" wx:key="name">
      <view class="item-main">
        <view class="item-name">{{item.name}} ×{{item.qty}}</view>
        <view class="item-sub" wx:if="{{item.dishesText}}">{{item.dishesText}}</view>
        <view class="item-sub" wx:if="{{item.specText}}">{{item.specText}}</view>
      </view>
      <view class="item-price">¥{{item.priceText}}</view>
    </view>
    <view class="total-row">
      <text>合计</text>
      <text class="total-amount">¥{{totalText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row"><text class="row-label">收款状态</text><text class="row-value">{{order.payStatusLabel}}</text></view>
    <!-- 实际退款额与备注：只标「已退款」不记金额，月底对账没有任何依据（P1-7） -->
    <view class="row" wx:if="{{order.payStatus === 'refunded' && refundText}}">
      <text class="row-label">实际退款</text><text class="row-value">¥{{refundText}}</text>
    </view>
    <view class="row" wx:if="{{order.payStatus === 'refunded' && order.refundRemark}}">
      <text class="row-label">退款备注</text><text class="row-value">{{order.refundRemark}}</text>
    </view>
    <view class="row"><text class="row-label">取送方式</text><text class="row-value">{{deliveryTypeText}}</text></view>
    <view class="row" wx:if="{{order.pickupSlot}}"><text class="row-label">取餐时段</text><text class="row-value">{{order.pickupSlot}}</text></view>
    <view class="row" wx:if="{{order.pickupCode}}"><text class="row-label">取餐码</text><text class="row-value code">{{order.pickupCode}}</text></view>
    <view class="row" wx:if="{{order.address}}"><text class="row-label">收货地址</text><text class="row-value">{{order.address.regionName}} {{order.address.detail}}</text></view>
    <view class="row" wx:if="{{order.remark}}"><text class="row-label">备注</text><text class="row-value">{{order.remark}}</text></view>
    <view class="row" wx:if="{{order.rejectReason}}"><text class="row-label">拒单原因</text><text class="row-value">{{order.rejectReason}}</text></view>
  </view>

  <!-- 状态流转：含「通知已发送 / 未送达」，用于判断系统到底发没发；耗时只算订单线节点 -->
  <view class="card" wx:if="{{timeline.length}}">
    <view class="card-title">状态流转</view>
    <view class="tl">
      <view class="tl-item tl-{{item.tone}}" wx:for="{{timeline}}" wx:key="id">
        <view class="tl-dot"></view>
        <view class="tl-body">
          <view class="tl-head">
            <text class="tl-label">{{item.label}}</text>
            <text class="tl-gap" wx:if="{{item.gapText}}">距上一步 {{item.gapText}}</text>
          </view>
          <view class="tl-meta">
            <text class="tl-time">{{item.timeText}}</text>
            <text class="tl-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 打印记录：多部手机共用一台打印机时，端上唯一能回答「谁打的、打了几张、成没成」的地方 -->
  <view class="card" wx:if="{{printRecords.length}}">
    <view class="card-title">打印记录</view>
    <view class="pr-row" wx:for="{{printRecords}}" wx:key="batchNo">
      <text class="pr-time">{{item.time}}</text>
      <text class="pr-who">{{item.who}}</text>
      <text class="pr-device" wx:if="{{item.device}}">{{item.device}}</text>
      <text class="pr-copies">{{item.successCopies}}/{{item.copies}} 张</text>
      <text class="pr-result {{item.ok ? 'pr-ok' : 'pr-fail'}}">{{item.resultText}}</text>
    </view>
  </view>

  <view class="bottom-gap"></view>

  <view class="bottom-bar">
    <view
      class="btn"
      wx:if="{{order.status === 'pending_accept' && !order.cancelRequested}}"
      bindtap="onAccept"
    >
      接单
    </view>
    <view
      class="btn btn-ghost"
      wx:if="{{order.status === 'pending_accept' && !order.cancelRequested}}"
      bindtap="onReject"
    >
      拒单
    </view>
    <view class="btn" wx:if="{{nextStatus && !(nextStatus === 'ready' && order.cancelRequested)}}" bindtap="onAdvance">{{nextLabel}}</view>
    <!-- 申请中不能出餐：先批或驳，否则等于一边审批取消一边把餐做出去 -->
    <view class="btn btn-disabled" wx:if="{{nextStatus === 'ready' && order.cancelRequested}}" bindtap="onAdvanceWhenRequested">
      先处理取消申请
    </view>

    <view
      class="btn"
      wx:if="{{order.payStatus === 'unpaid' || order.payStatus === 'claimed'}}"
      bindtap="onConfirmPay"
    >
      确认收款
    </view>
    <view class="btn btn-ghost" wx:if="{{order.payStatus === 'paid'}}" bindtap="onRevertPay">
      回退收款
    </view>
    <view class="btn btn-danger" wx:if="{{order.payStatus === 'refunding'}}" bindtap="onRefund">
      标记已退款
    </view>
    <!-- 打印：权限与看单一致，不新增 order.print（否则所有自定义角色都要重新勾选） -->
    <view
      class="btn btn-ghost"
      wx:if="{{printable}}"
      bindtap="onPreviewLabel"
    >
      {{previewing ? '生成中…' : '预览'}}
    </view>
    <view
      class="btn btn-ghost"
      wx:if="{{printable}}"
      bindtap="onPrintLabel"
    >
      {{busy ? '准备中…' : (printRecords.length ? '重打标签' : '打印标签')}}
    </view>
  </view>
</view>

<!-- 打印前预览 -->
<view class="mask" wx:if="{{previewVisible}}">
  <view class="dialog preview-dialog">
    <view class="dialog-title">打印预览</view>
    <image wx:if="{{previewSrc}}" class="preview-img" src="{{previewSrc}}" mode="widthFix"></image>
    <view class="preview-tip" wx:else>预览图生成失败，可直接打印。</view>
    <view class="progress-text">共 {{previewTotal}} 张</view>
    <view class="dialog-msg">看到的就是要打的，差别只有打印机浓度。</view>
    <view class="dialog-actions">
      <view class="btn btn-ghost" bindtap="onClosePreview">关闭</view>
      <view class="btn" bindtap="onPreviewPrint">开始打印 {{previewTotal}} 张</view>
    </view>
  </view>
</view>

<!-- 打印进度层 -->
<view class="mask" wx:if="{{printing}}">
  <view class="dialog">
    <view class="dialog-title">{{paused ? '打印机暂停' : '正在打印'}}</view>
    <view class="progress-text">{{printedCount}} / {{totalCount}} 张</view>
    <view class="progress-bar"><view class="progress-inner" style="width:{{progressPercent}}%"></view></view>
    <view class="dialog-msg" wx:if="{{printError}}">{{printError}}</view>
    <view class="dialog-msg" wx:elif="{{paused}}">处理好后点「继续」，打印机会接着打。</view>
    <view class="dialog-actions">
      <view class="btn btn-ghost" wx:if="{{paused}}" bindtap="onResumePrint">继续</view>
      <view class="btn btn-danger" bindtap="onCancelPrint">停止</view>
    </view>
  </view>
</view>

<view class="print-canvas">
  <canvas canvas-id="test" style="width:560px;height:320px;"></canvas>
</view>
