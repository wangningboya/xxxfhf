@import "./merchant.wxss";

.muted-note {
  font-size: 22rpx;
  color: #9a9a9a;
  padding-top: 8rpx;
}

.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6a6a6a;
  border-radius: 12rpx;
}

.tab-active {
  background: #fff3e0;
  color: #d97600;
  font-weight: 600;
}

.dish {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.dish:last-child {
  border-bottom: none;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  color: #1a1a1a;
}

.dish-group {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #d97600;
  background: #fff3e0;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}

.dish-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
}

.dish-qty {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff9f1c;
  min-width: 100rpx;
  text-align: right;
}

.region-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.region-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.region-flag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #3c6fbf;
  background: #eef4ff;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}

.region-qty {
  font-size: 24rpx;
  color: #9a9a9a;
}

.region-items {
  display: flex;
  flex-wrap: wrap;
}

.region-item {
  font-size: 24rpx;
  color: #4a4a4a;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  padding-top: 8rpx;
}

.slot {
  font-size: 22rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}

.contacts {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f4f5f7;
}

.contact {
  font-size: 24rpx;
  color: #6a6a6a;
  line-height: 1.9;
}
