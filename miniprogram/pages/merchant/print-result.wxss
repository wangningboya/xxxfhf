@import "./merchant.wxss";

.summary {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.summary-total {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.summary-row {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.summary-item {
  display: flex;
  align-items: baseline;
  margin: 0 30rpx;
}

.summary-item .num {
  font-size: 34rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.summary-item .ok {
  color: #2e9e5b;
}

.summary-item .fail {
  color: #d93a3a;
}

.summary-item .lbl {
  font-size: 24rpx;
  color: #8a8a8a;
}

.rrow {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.rrow:last-child {
  border-bottom: none;
}

.tick {
  color: #2e9e5b;
  margin-right: 14rpx;
  font-size: 26rpx;
}

.cross {
  color: #d93a3a;
  margin-right: 14rpx;
  font-size: 26rpx;
}

.rrow-name {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rrow-count {
  font-size: 26rpx;
  color: #6a6a6a;
  margin-left: 12rpx;
}

.rrow-reason {
  font-size: 24rpx;
  color: #d97600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.note {
  font-size: 22rpx;
  color: #9a9a9a;
  line-height: 1.6;
  padding-top: 16rpx;
}

.bottom-bar .btn {
  flex: 1;
  margin-left: 16rpx;
}

.bottom-bar .btn:first-child {
  flex: 0 0 180rpx;
  margin-left: 0;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.progress-text {
  font-size: 36rpx;
  color: #1a1a1a;
  text-align: center;
  margin: 24rpx 0 20rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f2f3f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #ff9f1c;
  border-radius: 6rpx;
  transition: width 0.2s;
}

.dialog-msg {
  font-size: 24rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 24rpx;
  line-height: 1.5;
}

.dialog-actions {
  display: flex;
  margin-top: 32rpx;
}

.dialog-actions .btn {
  flex: 1;
  margin-right: 16rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.dialog-actions .btn:last-child {
  margin-right: 0;
}

.print-canvas {
  position: fixed;
  left: 100%;
  top: 0;
}

/* 未打的行要两行：第一行定位（尾号+套餐+缺几张+原因），第二行对上袋子（联系人+电话尾号） */
.rrow-main {
  flex: 1;
  min-width: 0;
}

.rrow-line {
  display: flex;
  align-items: center;
}

.rrow-who {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-block {
  display: block;
  margin-top: 20rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 28rpx;
}
