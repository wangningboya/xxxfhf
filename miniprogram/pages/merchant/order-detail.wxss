@import "./merchant.wxss";

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.status {
  font-size: 26rpx;
  color: #ff9f1c;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

/* 「联系顾客」：号码是掩码，拨号要单独取一次全号，所以做成一个明确的小按钮 */
.call-btn {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid #ff9f1c;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ff9f1c;
}

.warn-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #c0392b;
}

.warn-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #c0392b;
  line-height: 1.6;
}

.handle {
  display: flex;
  margin-top: 24rpx;
}

.handle .btn {
  flex: 1;
  margin-left: 16rpx;
}

.handle .btn:first-child {
  margin-left: 0;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
  line-height: 1.5;
}

.item-price {
  font-size: 28rpx;
  color: #1a1a1a;
  padding-left: 16rpx;
}

.total-row {
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #1a1a1a;
}

.total-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8442e;
}

.code {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff9f1c;
  letter-spacing: 6rpx;
}

.bottom-bar .btn {
  flex: 1;
  margin-left: 16rpx;
}

.bottom-bar .btn:first-child {
  margin-left: 0;
}

/* ---------- 状态流转时间轴 ---------- */

.tl {
  position: relative;
  padding-left: 28rpx;
}

.tl::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 18rpx;
  bottom: 18rpx;
  width: 2rpx;
  background: #eeeeee;
}

.tl-item {
  position: relative;
  padding: 10rpx 0;
}

.tl-dot {
  position: absolute;
  left: -28rpx;
  top: 22rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff9f1c;
  border: 3rpx solid #ffffff;
  box-sizing: content-box;
}

/* 事件记录（通知成败、拨号留痕）不是状态变化，视觉上弱化；
   收款线单独一个颜色，便于和订单状态区分 */
.tl-event .tl-dot {
  background: #c8c8c8;
}

.tl-pay .tl-dot {
  background: #4a90e2;
}

.tl-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tl-label {
  font-size: 28rpx;
  color: #1a1a1a;
}

.tl-gap {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #ff9f1c;
}

.tl-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #888888;
}

.tl-time {
  margin-right: 12rpx;
  color: #b0b0b0;
}

/* ==================== 打印记录 ==================== */

.pr-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
  font-size: 24rpx;
  color: #6a6a6a;
}

.pr-row:last-child {
  border-bottom: none;
}

.pr-time {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.pr-who {
  flex-shrink: 0;
  margin-right: 16rpx;
  color: #1a1a1a;
}

.pr-device {
  flex: 1;
  color: #b0b0b0;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pr-copies {
  flex-shrink: 0;
  margin: 0 16rpx;
}

.pr-result {
  flex-shrink: 0;
}

.pr-ok {
  color: #2e9e5b;
}

.pr-fail {
  color: #c0392b;
}

/* ==================== 打印进度层 ==================== */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.progress-text {
  font-size: 36rpx;
  color: #1a1a1a;
  text-align: center;
  margin: 24rpx 0 20rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f2f3f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #ff9f1c;
  border-radius: 6rpx;
  transition: width 0.2s;
}

.dialog-msg {
  font-size: 24rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 24rpx;
  line-height: 1.5;
}

.dialog-actions {
  display: flex;
  margin-top: 32rpx;
}

.dialog-actions .btn {
  flex: 1;
  margin-right: 16rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.dialog-actions .btn:last-child {
  margin-right: 0;
}

.print-canvas {
  position: fixed;
  left: 100%;
  top: 0;
}

/* ==================== 打印前预览 ==================== */

.preview-dialog {
  width: 640rpx;
}

.preview-img {
  width: 100%;
  margin: 20rpx 0 4rpx;
  border-radius: 12rpx;
  background: #ffffff;
  /* 标签是白底黑字，给一圈浅灰边才看得出图的边界 */
  box-shadow: 0 0 0 2rpx #e6e8eb;
}

.preview-tip {
  margin: 20rpx 0 4rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  text-align: center;
}
