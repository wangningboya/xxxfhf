@import "./merchant.wxss";

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.status {
  font-size: 26rpx;
  color: #ff9f1c;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

/* 「联系顾客」：号码是掩码，拨号要单独取一次全号，所以做成一个明确的小按钮 */
.call-btn {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid #ff9f1c;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ff9f1c;
}

.warn-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #c0392b;
}

.warn-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #c0392b;
  line-height: 1.6;
}

.handle {
  display: flex;
  margin-top: 24rpx;
}

.handle .btn {
  flex: 1;
  margin-left: 16rpx;
}

.handle .btn:first-child {
  margin-left: 0;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
  line-height: 1.5;
}

.item-price {
  font-size: 28rpx;
  color: #1a1a1a;
  padding-left: 16rpx;
}

.total-row {
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #1a1a1a;
}

.total-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8442e;
}

.code {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff9f1c;
  letter-spacing: 6rpx;
}

.bottom-bar .btn {
  flex: 1;
  margin-left: 16rpx;
}

.bottom-bar .btn:first-child {
  margin-left: 0;
}

/* ---------- 状态流转时间轴 ---------- */

.tl {
  position: relative;
  padding-left: 28rpx;
}

.tl::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 18rpx;
  bottom: 18rpx;
  width: 2rpx;
  background: #eeeeee;
}

.tl-item {
  position: relative;
  padding: 10rpx 0;
}

.tl-dot {
  position: absolute;
  left: -28rpx;
  top: 22rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff9f1c;
  border: 3rpx solid #ffffff;
  box-sizing: content-box;
}

/* 事件记录（通知成败、拨号留痕）不是状态变化，视觉上弱化；
   收款线单独一个颜色，便于和订单状态区分 */
.tl-event .tl-dot {
  background: #c8c8c8;
}

.tl-pay .tl-dot {
  background: #4a90e2;
}

.tl-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tl-label {
  font-size: 28rpx;
  color: #1a1a1a;
}

.tl-gap {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #ff9f1c;
}

.tl-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #888888;
}

.tl-time {
  margin-right: 12rpx;
  color: #b0b0b0;
}
