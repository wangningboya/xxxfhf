@import "./merchant.wxss";

.page {
  padding: 24rpx;
}

.filters {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.date-pick {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #1a1a1a;
}

.search {
  flex: 1;
  margin-left: 16rpx;
}

.search-input {
  height: 68rpx;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.tabs {
  white-space: nowrap;
  padding: 8rpx 0 16rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 26rpx;
  background: #ffffff;
  color: #6a6a6a;
  font-size: 26rpx;
}

.tab-active {
  background: #ff9f1c;
  color: #ffffff;
  font-weight: 600;
}

.order {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.order-warn {
  background: #fff8f7;
  border: 1rpx solid #f5c6c2;
}

.order-head {
  display: flex;
  align-items: center;
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 2rpx solid #d8d8d8;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.check-on {
  background: #ff9f1c;
  border-color: #ff9f1c;
}

.check-off {
  background: #f5f6f8;
  border-color: #eceef1;
}

.order-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.order-status {
  font-size: 26rpx;
  /* 颜色由数据字典的 tagType 决定，见 app.wxss 的 .tag-* */
}

.order-summary {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
}

.order-remark {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  background: #fff7ea;
  border-radius: 10rpx;
}

.remark-tag {
  flex: none;
  margin-right: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #a86b00;
}

.remark-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #7a5300;
  word-break: break-all;
}

.order-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9a9a9a;
}

.badges {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}

.badge {
  font-size: 20rpx;
  color: #6a6a6a;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.badge-red {
  background: #fdecec;
  color: #c0392b;
}

.badge-warn {
  background: #fff8e6;
  color: #a86b00;
}

.order-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-phone {
  font-size: 24rpx;
  color: #8a8a8a;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #e8442e;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #b0b0b0;
  padding: 24rpx 0;
}

.accept {
  flex: 1;
  margin-left: 16rpx;
}

/* 批量拒单：挨着接单按钮，红底白字，勾选后才有 */
.reject {
  flex: 1;
  margin-left: 16rpx;
}

/* 底部三个按钮并排（全选 / 拒单 / 接单）：收紧内边距与字号，否则小屏会挤成两行 */
.bottom-bar .btn {
  padding: 0 20rpx;
  font-size: 28rpx;
}

/* 只看退订的筛选条：默认灰、开启后橙色底 */
.cancel-filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #666666;
}

.cancel-filter-on {
  background: #fff3e0;
  color: #d97706;
}

.cancel-filter-hint {
  font-size: 22rpx;
  color: #a86b00;
}

/* 打印完成：灰底绿字，与「份数已释放」的红色、"申请取消"的橙色区分开 */
.badge-done {
  background: #eaf7ee;
  color: #2e9e5b;
}

/* ==================== 打印进度层 ==================== */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.progress-text {
  font-size: 36rpx;
  color: #1a1a1a;
  text-align: center;
  margin: 24rpx 0 20rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f2f3f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #ff9f1c;
  border-radius: 6rpx;
  transition: width 0.2s;
}

.dialog-msg {
  font-size: 24rpx;
  color: #a86b00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 24rpx;
  line-height: 1.5;
}

.dialog-actions {
  display: flex;
  margin-top: 32rpx;
}

.dialog-actions .btn {
  flex: 1;
  margin-right: 16rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.dialog-actions .btn:last-child {
  margin-right: 0;
}

.print-canvas {
  position: fixed;
  left: 100%;
  top: 0;
}

/* ==================== 批量首张预览 ==================== */

.preview-dialog {
  width: 640rpx;
}

.preview-img {
  width: 100%;
  margin: 20rpx 0 4rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 0 0 2rpx #e6e8eb;
}

.preview-tip {
  margin: 24rpx 0 4rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  text-align: center;
}

.preview-content {
  margin-top: 20rpx;
}

.preview-line {
  font-size: 24rpx;
  color: #555555;
  line-height: 1.7;
}
