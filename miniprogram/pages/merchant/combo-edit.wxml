<view class="page">
  <view class="card">
    <view class="card-title">基本信息</view>
    <view class="field">
      <text class="field-label">名称</text>
      <input class="field-input" placeholder="如：红烧肉套餐" placeholder-class="ph"
             value="{{name}}" data-key="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">分类</text>
      <picker wx:if="{{categoryOptions.length}}" mode="selector" range="{{categoryOptions}}"
              range-key="label" value="{{categoryIndex}}" bindchange="onChangeCategory">
        <view class="field-input">{{categoryLabel || '请选择'}} ›</view>
      </picker>
      <view wx:else class="field-input muted">分类字典加载中…</view>
    </view>
    <view class="field">
      <text class="field-label">价格（元）</text>
      <input class="field-input" type="digit" placeholder="0.00" placeholder-class="ph"
             value="{{priceYuan}}" data-key="priceYuan" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">排序</text>
      <input class="field-input" type="number" placeholder="数字小的排前面（可不填）" placeholder-class="ph"
             value="{{sort}}" data-key="sort" bindinput="onInput" />
    </view>
    <view class="field cover-field">
      <text class="field-label">封面</text>
      <view class="cover-box">
        <image wx:if="{{coverPreview}}" class="cover-img" src="{{coverPreview}}" mode="aspectFill" bindtap="onChooseCover" />
        <view wx:else class="cover-add" bindtap="onChooseCover">
          {{uploading ? '上传中…' : '＋ 上传'}}
        </view>
        <text wx:if="{{coverPreview}}" class="cover-del" bindtap="onClearCover">移除</text>
      </view>
    </view>
    <view class="field">
      <text class="field-label">描述</text>
      <input class="field-input" placeholder="一句话介绍（可不填）" placeholder-class="ph"
             value="{{desc}}" data-key="desc" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">组成菜品（每菜可设份数）</view>
    <view wx:if="{{dishOptions.length === 0}}" class="muted">菜品库还是空的，先去「菜品库」添加原料菜</view>
    <view wx:for="{{dishOptions}}" wx:key="dishId" class="dish">
      <view class="dish-left" data-index="{{index}}" bindtap="onToggleDish">
        <view class="check {{item.checked ? 'check-on' : ''}}">{{item.checked ? '✓' : ''}}</view>
        <text class="dish-name">{{item.name}}</text>
      </view>
      <view wx:if="{{item.checked}}" class="stepper">
        <view class="step" data-id="{{item.dishId}}" data-step="-1" bindtap="onDishQty">−</view>
        <view class="step-num">{{item.qty}}</view>
        <view class="step" data-id="{{item.dishId}}" data-step="1" bindtap="onDishQty">＋</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">启用规格组</view>
    <view wx:if="{{specGroups.length === 0}}" class="muted">
      还没有规格组。规格组只能在网页后台创建（如「主食：白米饭 / 杂粮饭」）。
    </view>
    <view wx:else class="chips">
      <view wx:for="{{specGroups}}" wx:key="id"
            class="chip {{item.checked ? 'chip-active' : ''}}"
            data-id="{{item.id}}" bindtap="onToggleSpec">
        {{item.name}}{{item.required ? '（必选）' : ''}}
      </view>
    </view>
    <view class="hint">保存后，已发布的当天菜单不会自动更新，要到「每日菜单」撤下再重新发布</view>
  </view>

  <view class="bottom-gap"></view>
  <view class="bottom-bar">
    <view class="btn" bindtap="onSave">{{saving ? '保存中…' : '保存盒饭'}}</view>
  </view>

  <!-- 相册是微信隐私接口：上传封面时微信可能发起授权请求，本页必须有弹窗接住它 -->
  <privacy-modal id="privacyModal" />
</view>
