<view class="page">
  <view class="card">
    <view class="field">
      <input class="field-input" placeholder="搜索昵称或手机号" placeholder-class="ph"
             value="{{keyword}}" bindinput="onKeyword" />
    </view>
    <view class="chips" style="margin-top:16rpx">
      <view class="chip {{auditStatus === '' ? 'chip-active' : ''}}" data-status="" bindtap="onStatus">全部</view>
      <view class="chip {{auditStatus === 'approved' ? 'chip-active' : ''}}" data-status="approved" bindtap="onStatus">已通过</view>
      <view class="chip {{auditStatus === 'pending' ? 'chip-active' : ''}}" data-status="pending" bindtap="onStatus">待审核</view>
      <view class="chip {{auditStatus === 'rejected' ? 'chip-active' : ''}}" data-status="rejected" bindtap="onStatus">已驳回</view>
      <view class="chip {{auditStatus === 'disabled' ? 'chip-active' : ''}}" data-status="disabled" bindtap="onStatus">已停用</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty"><view class="empty-title">加载中…</view></view>

  <view wx:for="{{users}}" wx:key="userId" class="card">
    <view class="user-head" data-index="{{index}}" bindtap="onPickUser">
      <view>
        <view class="user-name">{{item.nickName || '未填昵称'}}</view>
        <view class="muted">{{item.phone || '无手机号'}} · {{item.auditStatus}}</view>
      </view>
      <text class="muted">{{selectedUser.userId === item.userId ? '收起' : '地址 ›'}}</text>
    </view>

    <block wx:if="{{selectedUser.userId === item.userId}}">
      <view class="addr-head">
        <text class="muted">收货地址 {{addresses.length}} 个</text>
        <text class="addr-add" bindtap="onNewAddress">＋ 新增</text>
      </view>

      <view wx:if="{{addresses.length === 0}}" class="muted">还没有地址</view>
      <view wx:for="{{addresses}}" wx:key="id" wx:for-item="addr" wx:for-index="addrIndex" class="addr">
        <view class="addr-top">
          <text class="addr-region">{{addr.regionName}}</text>
          <text class="addr-status {{addr.status === 'active' ? 'addr-on' : ''}}">
            {{addr.status === 'active' ? '可用' : '待确认'}}
          </text>
        </view>
        <view class="addr-detail">{{addr.contactName}} {{addr.phone}}</view>
        <view class="muted">{{addr.detail}}</view>
        <view class="addr-ops">
          <text class="op" data-index="{{addrIndex}}" bindtap="onEditAddress">编辑</text>
          <text class="op" data-index="{{addrIndex}}" bindtap="onToggleAddress">
            {{addr.status === 'active' ? '设为待确认' : '确认可用'}}
          </text>
          <text class="op op-danger" data-index="{{addrIndex}}" bindtap="onDeleteAddress">删除</text>
        </view>
      </view>

      <!-- 地址表单 -->
      <view wx:if="{{form}}" class="form">
        <view class="field">
          <text class="field-label">区域</text>
          <picker mode="selector" range="{{regions}}" range-key="name"
                  value="{{formRegionIndex}}" bindchange="onRegionChange">
            <view class="field-input">{{regions[formRegionIndex].name || '请选择'}} ›</view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">联系人</text>
          <input class="field-input" placeholder="收货人姓名" placeholder-class="ph"
                 value="{{form.contactName}}" data-key="contactName" bindinput="onFormInput" />
        </view>
        <view class="field">
          <text class="field-label">手机号</text>
          <input class="field-input" type="number" maxlength="11" placeholder="11 位手机号"
                 placeholder-class="ph" value="{{form.phone}}" data-key="phone" bindinput="onFormInput" />
        </view>
        <view class="field">
          <text class="field-label">详细地址</text>
          <input class="field-input" placeholder="楼栋、门牌号" placeholder-class="ph"
                 value="{{form.detail}}" data-key="detail" bindinput="onFormInput" />
        </view>
        <view class="field">
          <text class="field-label">标签</text>
          <input class="field-input" placeholder="公司 / 家（可不填）" placeholder-class="ph"
                 value="{{form.tag}}" data-key="tag" bindinput="onFormInput" />
        </view>
        <view class="form-ops">
          <view class="btn btn-ghost" bindtap="onCancelForm">取消</view>
          <view class="btn" bindtap="onSaveAddress">{{saving ? '保存中…' : '保存地址'}}</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loading && users.length === 0}}" class="empty">
    <view class="empty-title">还没有符合条件的用户</view>
    <view class="empty-desc">用户从群卡片或邀请码进入小程序后会出现在这里</view>
  </view>
</view>
