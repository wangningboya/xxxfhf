@import "./merchant.wxss";

.invite {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.invite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-head-right {
  display: flex;
  align-items: center;
}

/* 「全部复制」：绿色文字，与右侧「展开」拉开距离，避免误点 */
.invite-copy-all {
  margin-right: 24rpx;
  font-size: 24rpx;
  color: #07c160;
}

.invite-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.invite-more {
  font-size: 24rpx;
  color: #9a9a9a;
}

.invite-body {
  margin-top: 20rpx;
}

.invite-desc {
  font-size: 24rpx;
  color: #9a9a9a;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.invite-list {
  margin-bottom: 16rpx;
}

.invite-item {
  display: block;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.invite-line {
  display: flex;
  align-items: center;
}

.invite-code {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 4rpx;
}

.invite-status {
  font-size: 22rpx;
  color: #9a9a9a;
}

/* 作废与过期分色：作废是商家主动撤销，需要更醒目 */
.invite-status-revoked {
  color: #d93026;
}

.invite-status-expired {
  color: #b0b0b0;
}

.invite-revoke {
  margin-left: 18rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: #d93026;
  border: 1rpx solid #f0b9b4;
  border-radius: 20rpx;
}

/* 使用者那行：码用掉了才出现，字号小一档，不抢码本身 */
.invite-user {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
}

.invite-action {
  margin-left: 18rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: #07c160;
  border: 1rpx solid #a8e6c1;
  border-radius: 20rpx;
}

.search {
  margin-bottom: 16rpx;
}

.search-input {
  height: 68rpx;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.tabs {
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 26rpx;
  background: #ffffff;
  color: #6a6a6a;
  font-size: 26rpx;
}

.tab-active {
  background: #ff9f1c;
  color: #ffffff;
  font-weight: 600;
}

.user {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.user-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0f1f3;
  flex-shrink: 0;
}

.avatar-empty {
  background: #eceef1;
}

.user-info {
  flex: 1;
  padding-left: 20rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.user-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.user-reason {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #c0392b;
}

.user-hint {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

/* 置灰按钮仍绑着 onAudit：点了弹一句「对方还没填昵称」，比没反应好 */
.btn-disabled {
  opacity: 0.45;
}

.user-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.small {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  margin-left: 16rpx;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #b0b0b0;
  padding: 24rpx 0;
}
