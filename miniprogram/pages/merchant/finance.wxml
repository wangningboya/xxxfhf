<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">供餐日</text>
      <picker mode="date" value="{{serveDate}}" bindchange="onDateChange">
        <view class="field-input">{{serveDate}} ›</view>
      </picker>
    </view>
    <view class="muted">共 {{orderCount}} 单。数字只看，改动在订单详情里做。</view>
  </view>

  <view class="buckets">
    <view wx:for="{{buckets}}" wx:key="key"
          class="bucket {{detailBucket === item.key ? 'bucket-on' : ''}}"
          data-bucket="{{item.key}}" bindtap="onBucket">
      <view class="bucket-label">{{item.label}}</view>
      <view class="bucket-amount">¥{{item.amountText}}</view>
      <view class="bucket-count">{{item.count}} 单</view>
      <view class="bucket-hint">{{item.hint}}</view>
    </view>
  </view>

  <!--
    勾稽校验（v3.50 / F-J14）：净应收 − 净已收 − 未收 − 待确认 = 差额，应恒为 0。
    六个数字各自看都对、合起来不平，是最难查的一类账，这一行就是用来自证的。
  -->
  <view class="check {{checkDiff === 0 ? 'check-ok' : 'check-bad'}}">
    <view class="check-eq">
      净应收 ¥{{checkText.netReceivable}} − 净已收 ¥{{checkText.netReceived}}
      − 未收 ¥{{checkText.unpaid}} − 待确认 ¥{{checkText.claimed}}
    </view>
    <view class="check-diff">
      差额 ¥{{checkText.difference}}
      <text class="check-note">{{checkDiff === 0 ? '账平' : '应为 0'}}</text>
    </view>
    <view wx:if="{{checkDiff !== 0}}" class="check-rows">
      <view class="check-row" wx:for="{{checkRows}}" wx:key="orderNo">
        <text>{{item.orderNo}} · {{item.statusLabel}} / {{item.payStatusLabel}}</text>
        <text>¥{{item.contributionText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{detailBucket}}" class="card">
    <view class="card-title">{{detailTitle}}</view>
    <view wx:if="{{detailLoading}}" class="muted">加载中…</view>
    <view wx:elif="{{detail.length === 0}}" class="muted">这一栏没有订单</view>
    <view wx:for="{{detail}}" wx:key="orderNo" class="line">
      <view class="line-head">
        <text class="line-no">{{item.orderNo}}</text>
        <text class="line-amount">¥{{item.totalText}}</text>
      </view>
      <view class="muted">{{item.contactName}} · {{item.deliveryType}}</view>
      <view class="muted">{{item.statusLabel}} / {{item.payStatusLabel}}</view>
      <view class="muted">{{item.items}}</view>
    </view>
  </view>

  <view wx:if="{{!detailBucket}}" class="muted" style="text-align:center">
    点任意一栏查看对应订单明细
  </view>
</view>
