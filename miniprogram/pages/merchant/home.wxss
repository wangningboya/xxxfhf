@import "./merchant.wxss";

.head {
  padding: 24rpx 8rpx 28rpx;
}

.head-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

/*
 * 待办从 3 个增到 5 个，一行放不下，改成每行 3 个自动换行。
 * 用 gap 而不是给每个加 margin-right：换行后行末不留空档。
 */
.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff9f1c;
}

/* 有积压的待办用红字，零值不刺眼 */
.stat-warn {
  color: #d93026;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.grid-item:nth-child(odd) {
  margin-right: 20rpx;
}

.grid-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.grid-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9a9a9a;
}

.logout {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a8a8a8;
  padding: 24rpx 0;
}
