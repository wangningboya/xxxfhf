@import "./merchant.wxss";

.dish-row {
  display: flex;
  align-items: center;
}

.dish-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.dish-main {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.badge {
  display: inline-block;
  white-space: nowrap;
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background: #f0f0f0;
  color: #a8a8a8;
}

.badge-on {
  background: #e8f5e9;
  color: #2e7d32;
}

.ops {
  display: flex;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f4f5f7;
}

.op {
  font-size: 26rpx;
  color: #4a6fa5;
  margin-right: 40rpx;
}

.op-danger {
  color: #c0392b;
}

.img-box {
  flex: 1;
}

.img-add {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  border: 1rpx dashed #d8d8d8;
  color: #9a9a9a;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-ops {
  display: flex;
  margin-top: 24rpx;
}

.form-ops .btn {
  flex: 1;
  margin-right: 20rpx;
}

.form-ops .btn:last-child {
  margin-right: 0;
}

.bottom-bar .btn {
  flex: 1;
}
