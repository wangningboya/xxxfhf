<view class="page {{batchMode ? 'page-batch' : ''}}">
  <view class="invite">
    <view class="invite-head">
      <text class="invite-title" bindtap="onToggleInvite">邀请码</text>
      <view class="invite-head-right">
        <!-- 批量发出去后一次性复制：只复制未使用的，已用/作废的复制了也没用 -->
        <text
          class="invite-copy-all"
          wx:if="{{showInvite && inviteCodes.length}}"
          catchtap="onCopyAllCodes"
        >
          全部复制
        </text>
        <text class="invite-more" bindtap="onToggleInvite">{{showInvite ? '收起' : '展开'}} ›</text>
      </view>
    </view>
    <view class="invite-body" wx:if="{{showInvite}}">
      <view class="invite-desc">群里没有群卡片、或者对方不在群里时，用邀请码放行。一次性、有有效期。</view>
      <view class="invite-list" wx:if="{{inviteCodes.length}}">
        <view class="invite-item" wx:for="{{inviteCodes}}" wx:key="code">
          <view class="invite-line">
            <text class="invite-code">{{item.code}}</text>
            <text class="invite-status invite-status-{{item.status}}">{{item.statusText}}</text>
            <!-- 显式「复制」按钮：整行点击复制太隐蔽，商家找不到入口 -->
            <text class="invite-action" data-code="{{item.code}}" bindtap="onCopyCode">复制</text>
            <text
              class="invite-revoke"
              wx:if="{{item.status === 'unused'}}"
              data-code="{{item.code}}"
              catchtap="onRevokeCode"
            >
              作废
            </text>
          </view>
          <!-- 用过的码要能对上人：谁用的、手机尾号 -->
          <view class="invite-user" wx:if="{{item.usedByName}}">
            使用者：{{item.usedByName}}{{item.usedByPhone ? '（' + item.usedByPhone + '）' : ''}}
          </view>
        </view>
      </view>
      <view class="btn" bindtap="onCreateInvite">{{creating ? '生成中…' : '生成邀请码'}}</view>
    </view>
  </view>

  <view class="search">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜昵称 / 手机号"
      placeholder-class="ph"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
  </view>

  <scroll-view class="tabs" scroll-x enable-flex>
    <view
      class="tab {{auditStatus === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSwitchTab"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 批量通过只对待审核页签开放：驳回要逐个人看原因，恢复与启停也不该成批点 -->
  <view class="bulk-entry" wx:if="{{auditStatus === 'pending' && list.length}}">
    <text class="{{batchMode ? 'bulk-cancel' : 'bulk-open'}}" bindtap="onToggleBatch">
      {{batchMode ? '取消' : '批量通过'}}
    </text>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <view class="empty-title">这里没有人</view>
    <view class="empty-desc">群成员首次进入就会出现在「待审核」</view>
  </view>

  <view
    class="user {{batchMode ? 'user-batch' : ''}}"
    wx:for="{{list}}"
    wx:key="userId"
    data-index="{{index}}"
    bindtap="onCardTap"
  >
    <!-- 批量模式才有勾选框：日常单个审核时不该多一列东西 -->
    <view class="user-check" wx:if="{{batchMode}}">
      <view class="checkbox {{item.checked ? 'checkbox-on' : ''}} {{item.canAudit ? '' : 'checkbox-off'}}">{{item.checked ? '✓' : ''}}</view>
    </view>
    <view class="user-main">
      <view class="user-head">
        <image class="avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view class="avatar avatar-empty" wx:else></view>
        <view class="user-info">
          <view class="user-name">{{item.nickName}}</view>
          <view class="user-sub">
            <text wx:if="{{item.phone}}">{{item.phone}}</text>
            <text wx:else>未填手机号</text>
            <text wx:if="{{item.accessVia}}"> · 通过{{item.accessVia === 'group' ? '群' : '邀请码'}}进入</text>
          </view>
        </view>
      </view>

      <view class="user-reason" wx:if="{{item.rejectReason}}">驳回原因：{{item.rejectReason}}</view>

      <!-- 没填昵称：人照样在列表里，但通过/驳回置灰，免得商家凭 id 瞎点 -->
      <view class="user-hint" wx:if="{{(item.auditStatus === 'pending' || item.auditStatus === 'rejected') && !item.canAudit}}">
        对方还没填昵称，填完才能审核
      </view>

      <!-- 批量模式下藏起单个动作：勾选时误点「驳回」是最不该发生的事 -->
      <view class="user-actions" wx:if="{{!batchMode}}">
        <view
          class="btn btn-ghost small {{item.auditStatus === 'rejected' && !item.canAudit ? 'btn-disabled' : ''}}"
          wx:if="{{item.auditStatus === 'rejected' || item.auditStatus === 'disabled'}}"
          data-id="{{item.userId}}"
          data-action="{{item.auditStatus === 'rejected' ? 'approve' : 'enable'}}"
          data-can-audit="{{item.canAudit}}"
          bindtap="onAudit"
        >
          恢复
        </view>
        <view
          class="btn btn-ghost small"
          wx:if="{{item.auditStatus === 'approved'}}"
          data-id="{{item.userId}}"
          data-action="disable"
          bindtap="onAudit"
        >
          停用
        </view>
        <view
          class="btn btn-ghost small {{item.canAudit ? '' : 'btn-disabled'}}"
          wx:if="{{item.auditStatus === 'pending'}}"
          data-id="{{item.userId}}"
          data-action="reject"
          data-can-audit="{{item.canAudit}}"
          bindtap="onAudit"
        >
          驳回
        </view>
        <view
          class="btn small {{item.canAudit ? '' : 'btn-disabled'}}"
          wx:if="{{item.auditStatus === 'pending'}}"
          data-id="{{item.userId}}"
          data-action="approve"
          data-can-audit="{{item.canAudit}}"
          bindtap="onAudit"
        >
          通过
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提交条：只在批量模式出现，避免常驻占位 -->
  <view class="bulk-bar" wx:if="{{batchMode}}">
    <text class="bulk-count">已选 {{batchCount}} 人</text>
    <view class="btn small bulk-submit {{batchCount ? '' : 'btn-disabled'}}" bindtap="onBatchApprove">
      通过（{{batchCount}}）
    </view>
  </view>

  <view class="tip" wx:if="{{loading}}">加载中…</view>
  <view class="tip" wx:elif="{{finished && list.length}}">没有更多了</view>
</view>
