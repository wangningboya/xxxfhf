<view class="page">
  <view class="profile">
    <image class="avatar" wx:if="{{me.avatarUrl}}" src="{{me.avatarUrl}}" mode="aspectFill" />
    <view class="avatar avatar-empty" wx:else></view>
    <view class="profile-body">
      <view class="nick" bindtap="onEditNick">
        {{me.nickName || '点这里填昵称'}}
        <text class="nick-edit">修改</text>
      </view>
      <view class="phone" bindtap="onEditPhone">
        {{me.phone || '未填写手机号'}}
        <text class="nick-edit">修改</text>
      </view>
    </view>
  </view>

  <view class="audit">
    <view class="audit-title">{{auditTitle}}</view>
    <view class="audit-desc">{{auditDesc}}</view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="onOpenOrders">
      <text>我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onOpenAddress">
      <text>收货地址</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{phoneAuthEnabled}}" bindtap="onEditPhone">
      <text>手机号一键授权</text>
      <text class="arrow">›</text>
    </view>
    <button
      class="menu-item menu-btn"
      wx:if="{{phoneAuthEnabled}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >
      <text>用微信绑定手机号</text>
      <text class="arrow">›</text>
    </button>
    <view class="menu-item" bindtap="onOpenMerchant">
      <text>我是商家</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 昵称编辑浮层 -->
  <view class="mask" wx:if="{{nickEditing}}">
    <view class="panel">
      <view class="panel-title">修改昵称</view>
      <input
        class="panel-input"
        type="nickname"
        value="{{nickInput}}"
        placeholder="点击可一键填入微信昵称"
        placeholder-class="ph"
        maxlength="32"
        bindinput="onNickInput"
        bindblur="onNickInput"
        bindchange="onNickInput"
      />
      <view class="panel-actions">
        <view class="panel-btn panel-ghost" bindtap="onCancelNick">取消</view>
        <view class="panel-btn" bindtap="onSaveNick">{{saving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- 手机号编辑浮层 -->
  <view class="mask" wx:if="{{phoneEditing}}">
    <view class="panel">
      <view class="panel-title">填写手机号</view>
      <input
        class="panel-input"
        type="number"
        value="{{phoneInput}}"
        placeholder="11 位手机号"
        placeholder-class="ph"
        maxlength="11"
        bindinput="onPhoneInput"
      />
      <view class="panel-actions">
        <view class="panel-btn panel-ghost" bindtap="onCancelPhone">取消</view>
        <view class="panel-btn" bindtap="onSavePhone">{{saving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>
