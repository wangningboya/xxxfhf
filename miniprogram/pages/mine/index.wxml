<view class="page">
  <view class="profile">
    <image class="avatar" wx:if="{{me.avatarUrl}}" src="{{me.avatarUrl}}" mode="aspectFill" />
    <view class="avatar avatar-empty" wx:else></view>
    <view class="profile-body">
      <view class="nick" bindtap="onEditNick">
        {{me.nickName || '点这里填昵称'}}
        <text class="nick-edit">修改</text>
      </view>
      <view class="phone" bindtap="onEditPhone">
        {{me.phone || '未填写手机号'}}
        <text class="nick-edit">修改</text>
      </view>
    </view>
  </view>

  <view class="audit">
    <view class="audit-title">{{auditTitle}}</view>
    <view class="audit-desc">{{auditDesc}}</view>
  </view>

  <!-- 宫格：每行 3 个，手机号格位常驻，商家账号多一个工作台入口，不足一行靠左 -->
  <view class="grid">
    <view
      class="grid-cell"
      wx:for="{{cells}}"
      wx:key="key"
      data-action="{{item.key}}"
      bindtap="onTapCell"
    >
      <image class="grid-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="grid-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 昵称编辑浮层 -->
  <view class="mask" wx:if="{{nickEditing}}">
    <view class="panel">
      <view class="panel-title">修改昵称</view>
      <input
        class="panel-input"
        type="nickname"
        value="{{nickInput}}"
        placeholder="点击可一键填入微信昵称"
        placeholder-class="ph"
        maxlength="32"
        bindinput="onNickInput"
        bindblur="onNickInput"
        bindchange="onNickInput"
        bindnicknamereview="onNickReview"
      />
      <view class="panel-actions">
        <view class="panel-btn panel-ghost" bindtap="onCancelNick">取消</view>
        <view class="panel-btn" bindtap="onSaveNick">{{saving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- 手机号修改浮层：当前号只回显掩码、不可编辑，新号填在下面 -->
  <view class="mask" wx:if="{{phoneEditing}}">
    <view class="panel">
      <view class="panel-title">修改手机号</view>
      <view class="panel-current">
        <text class="panel-current-label">当前手机号</text>
        <text class="panel-current-value">{{me.phone || '未填写手机号'}}</text>
      </view>
      <input
        class="panel-input"
        type="number"
        value="{{phoneInput}}"
        placeholder="输入新手机号（11 位）"
        placeholder-class="ph"
        maxlength="11"
        bindinput="onPhoneInput"
      />
      <view class="panel-actions">
        <view class="panel-btn panel-ghost" bindtap="onCancelPhone">取消</view>
        <view class="panel-btn" bindtap="onSavePhone">{{saving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- 隐私与账号：注销入口只给群成员，商家账号在网页后台上管理 -->
  <view class="links">
    <view class="link" bindtap="onOpenLicense">证照公示</view>
    <view class="link" bindtap="onOpenPrivacy">隐私政策</view>
    <view class="link link-danger" wx:if="{{me.userType !== 'merchant'}}" bindtap="onDeleteAccount">
      注销账号
    </view>
  </view>

  <!-- 收集手机号/昵称前的隐私提示，由 utils/privacy.js 唤起 -->
  <privacy-modal id="privacyModal" />
</view>
