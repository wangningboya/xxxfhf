page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  /* 底部让出 tabBar 与安全区 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  min-height: 100vh;
  box-sizing: border-box;
}

.profile {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f1f3;
  flex-shrink: 0;
}

.avatar-empty {
  background: #eceef1;
}

.profile-body {
  flex: 1;
  padding-left: 24rpx;
}

.nick {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.phone {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.nick-edit {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #ff9f1c;
  font-weight: 400;
}

.audit {
  background: #fff8e6;
  border: 1rpx solid #ffe0a3;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.audit-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #a86b00;
}

.audit-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #a86b00;
  line-height: 1.6;
}

/* ---------- 宫格：每行 3 个 ---------- */

.grid {
  display: flex;
  flex-wrap: wrap;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 0;
}

.grid-cell {
  width: 33.333%;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-icon {
  width: 56rpx;
  height: 56rpx;
}

.grid-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #3a3a3a;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  z-index: 100;
}

.panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 44rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.panel-input {
  margin-top: 28rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.ph {
  color: #b0b0b0;
  font-size: 28rpx;
}

.panel-actions {
  display: flex;
  margin-top: 36rpx;
}

.panel-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.panel-btn:first-child {
  margin-left: 0;
}

.panel-ghost {
  background: #f5f6f8;
  color: #4a4a4a;
}

/* 隐私政策与注销入口：放在页面最底部，弱化但可达 */
.links {
  margin-top: 56rpx;
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.link {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #9a9a9a;
}

.link-danger {
  color: #c0392b;
}
