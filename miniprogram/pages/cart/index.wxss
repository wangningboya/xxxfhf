page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.head-date {
  font-size: 26rpx;
  color: #8a8a8a;
}

.head-clear {
  font-size: 26rpx;
  color: #b0b0b0;
}

.empty {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 72rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: #1a1a1a;
}

.empty-btn {
  margin: 32rpx auto 0;
  width: 240rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.line {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f3f5;
  position: relative;
}

.line:last-child {
  border-bottom: none;
}

.line-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background: #f0f1f3;
  flex-shrink: 0;
}

.line-cover-empty {
  background: #f0f1f3;
}

.line-body {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}

.line-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.line-spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a9a9a;
  line-height: 1.5;
}

.line-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.line-price {
  font-size: 30rpx;
  color: #e8442e;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f0f1f3;
  color: #4a4a4a;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-value {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
}

.line-remove {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 22rpx;
  color: #c0c0c0;
}

.bottom-gap {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #8a8a8a;
}

.total-amount {
  margin-left: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #e8442e;
}

.checkout {
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: 42rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
}
