page {
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  /* 底部让出 tabBar（约 100rpx）与安全区，否则最后一份菜会被遮住 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  min-height: 100vh;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.shop-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.top-actions {
  display: flex;
  align-items: center;
}

.top-link {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-left: 28rpx;
}

.shop-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.shop-notice {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.5;
}

.shop-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b0b0b0;
}

.audit-card {
  background: #fff8e6;
  border: 1rpx solid #ffe0a3;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.audit-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #a86b00;
}

.audit-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #a86b00;
  line-height: 1.6;
}

.audit-btn {
  margin-top: 24rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.audit-btn::after {
  border: none;
}

/* ---------- 供餐日切换 ---------- */

.date-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.date-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 14rpx;
}

.date-tab-active {
  background: #fff3e0;
}

.date-tab-label {
  font-size: 30rpx;
  color: #6a6a6a;
}

.date-tab-active .date-tab-label {
  color: #ff9f1c;
  font-weight: 600;
}

.date-tab-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #b0b0b0;
}

.banner {
  background: #eef4ff;
  color: #3c6fbf;
  font-size: 26rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.banner-warn {
  background: #fff8e6;
  color: #a86b00;
}

/* ---------- 菜单列表 ---------- */

.menu-empty {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 56rpx 32rpx;
  text-align: center;
}

.menu-empty-title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.menu-empty-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #9a9a9a;
  line-height: 1.7;
}

.menu-item {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.menu-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f0f1f3;
  flex-shrink: 0;
}

.menu-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #b0b0b0;
}

.menu-body {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}

.menu-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.menu-dishes {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a9a9a;
  line-height: 1.5;
}

.menu-foot {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
}

.menu-price {
  font-size: 34rpx;
  color: #e8442e;
  font-weight: 600;
}

.menu-remain {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #b0b0b0;
}

/* 全部菜单 Tab 的「明日供应 / 暂不供应」标签 */
.menu-tomorrow {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #b0b0b0;
}

.menu-tomorrow-on {
  color: #ff9f1c;
}

.menu-add-wrap {
  display: flex;
  align-items: flex-end;
}

.menu-add {
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.menu-add-disabled {
  background: #e6e6e6;
  color: #a8a8a8;
}

/* ---------- 购物车悬浮球 ---------- */

.cart-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #ff9f1c;
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 28, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.cart-fab-icon {
  width: 52rpx;
  height: 52rpx;
}

.cart-fab-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #e8442e;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ---------- 昵称填写浮层 ---------- */

.nick-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  z-index: 100;
}

.nick-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.nick-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nick-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9a9a9a;
  line-height: 1.6;
}

.nick-input {
  margin-top: 32rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.nick-placeholder {
  color: #b0b0b0;
  font-size: 28rpx;
}

.nick-btn {
  margin-top: 36rpx;
  background: #ff9f1c;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.nick-btn::after {
  border: none;
}
