<view class="page">
  <view class="topbar">
    <view class="shop-name">{{shopName}}</view>
    <view class="top-actions">
      <text class="top-link" bindtap="onOpenOrders">我的订单</text>
      <text class="top-link" bindtap="onOpenMine">我的</text>
    </view>
  </view>

  <view class="shop-card">
    <view class="shop-notice" wx:if="{{shopNotice}}">{{shopNotice}}</view>
    <view class="shop-meta">
      <text wx:if="{{serveTimeText}}">供餐：{{serveTimeText}}</text>
      <text wx:if="{{cutoffTime}}"> · 前一天 {{cutoffTime}} 截单</text>
    </view>
  </view>

  <view class="audit-card" wx:if="{{showAuditCard}}">
    <view class="audit-title">{{auditTitle}}</view>
    <view class="audit-desc">{{auditDesc}}</view>
    <button
      class="audit-btn"
      wx:if="{{auditStatus === 'rejected'}}"
      loading="{{reapplyLoading}}"
      bindtap="onReapply"
    >
      重新提交申请
    </button>
  </view>

  <!-- 供餐日：明天可下单，后天只读；第三个 Tab 是盒饭库全量浏览 -->
  <view class="date-tabs">
    <view
      class="date-tab {{activeDate === item.date && !allActive ? 'date-tab-active' : ''}}"
      wx:for="{{dates}}"
      wx:key="date"
      data-date="{{item.date}}"
      bindtap="onSwitchDate"
    >
      <view class="date-tab-label">{{item.label}}</view>
      <view class="date-tab-sub">{{item.date}}</view>
    </view>
    <view class="date-tab {{allActive ? 'date-tab-active' : ''}}" bindtap="onSwitchAll">
      <view class="date-tab-label">全部菜单</view>
      <view class="date-tab-sub">只浏览</view>
    </view>
  </view>

  <block wx:if="{{!allActive}}">
    <view class="banner banner-warn" wx:if="{{menu.closed}}">该供餐日门店暂停供应</view>
    <view class="banner banner-warn" wx:elif="{{menu.cutoff}}">今日已截单，0 点后可继续下单</view>
    <view class="banner" wx:elif="{{!menu.orderable}}">该日菜单仅供浏览，明天才开放下单</view>

    <!-- 分类导航：左侧分类、右侧商品（需求 4.22）。只有一类时左侧整块不渲染，等于没得筛 -->
    <view class="menu-split">
      <view class="cat-side" wx:if="{{showCategoryTabs}}">
        <view
          class="cat-side-item {{activeCategory === item.key ? 'cat-side-item-active' : ''}}"
          wx:for="{{categoryTabs}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onSwitchCategory"
        >{{item.label}}</view>
      </view>

      <view class="menu-main">
        <!-- 左栏只列这份菜单里真的有商品的分类，所以空态只有「这份菜单是空的」一种 -->
        <view class="menu-empty" wx:if="{{!menuLoading && !viewItems.length}}">
          <view class="menu-empty-title">{{activeDate === dates[0].date ? '明日暂无供应' : '这个供餐日还没有菜单'}}</view>
          <view class="menu-empty-desc">商家发布后就能看到，可以先去「全部菜单」看看。</view>
        </view>

        <view class="menu-list">
          <view class="menu-item" wx:for="{{viewItems}}" wx:key="comboId">
            <image class="menu-cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
            <view class="menu-cover menu-cover-empty" wx:else>暂无图</view>

            <view class="menu-body" data-id="{{item.comboId}}" bindtap="onOpenCombo">
              <view class="menu-name">{{item.name}}</view>
              <view class="menu-dishes" wx:if="{{item.dishesText}}">{{item.dishesText}}</view>
              <view class="menu-foot">
                <text class="menu-price">¥{{item.priceText}}</text>
                <text class="menu-remain">{{item.remainText}}</text>
              </view>
            </view>

            <view class="menu-add-wrap">
              <view
                class="menu-add {{item.soldOut || !menu.orderable || auditStatus !== 'approved' ? 'menu-add-disabled' : ''}}"
                data-id="{{item.comboId}}"
                bindtap="onQuickAdd"
              >
                {{item.hasSpec ? '选规格' : '＋'}}
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 全部菜单：只浏览，点卡片进详情后按当前供餐日下单 -->
  <block wx:else>
    <view class="menu-empty" wx:if="{{allLoading}}">
      <view class="menu-empty-desc">加载中…</view>
    </view>
    <view class="menu-empty" wx:elif="{{!allItems.length}}">
      <view class="menu-empty-title">还没有上架的盒饭</view>
      <view class="menu-empty-desc">商家上架后就能在这里看到全部盒饭。</view>
    </view>
    <view class="menu-list" wx:else>
      <view class="menu-item" wx:for="{{allItems}}" wx:key="comboId">
        <image class="menu-cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="menu-cover menu-cover-empty" wx:else>暂无图</view>

        <view class="menu-body" data-id="{{item.comboId}}" bindtap="onOpenCombo">
          <view class="menu-name">{{item.name}}</view>
          <view class="menu-dishes" wx:if="{{item.dishesText}}">{{item.dishesText}}</view>
          <view class="menu-dishes" wx:elif="{{item.desc}}">{{item.desc}}</view>
          <view class="menu-foot">
            <text class="menu-price">¥{{item.priceText}}</text>
            <text class="menu-tomorrow {{item.tomorrowText === '明日供应' ? 'menu-tomorrow-on' : ''}}">{{item.tomorrowText}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 购物车入口：右下角悬浮球，带数量角标；空车不渲染（决策 D-15） -->
  <view class="cart-fab" wx:if="{{cartCount > 0}}" bindtap="onOpenCart">
    <image class="cart-fab-icon" src="/assets/tabbar/cart.png" mode="aspectFit" />
    <view class="cart-fab-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
  </view>

  <!-- 昵称填写：微信不再返回真实昵称，只能由用户自己点选或手填一次 -->
  <view class="nick-mask" wx:if="{{needNickName}}">
    <view class="nick-panel">
      <view class="nick-title">先留个称呼</view>
      <view class="nick-desc">方便商家认出你，填一次就好。</view>
      <input
        class="nick-input"
        type="nickname"
        value="{{nickNameInput}}"
        placeholder="点击可一键填入微信昵称"
        placeholder-class="nick-placeholder"
        maxlength="32"
        bindinput="onNickNameInput"
        bindblur="onNickNameInput"
        bindchange="onNickNameInput"
      />
      <button class="nick-btn" loading="{{savingNickName}}" bindtap="onSaveNickName">保存</button>
    </view>
  </view>

  <!-- 保存昵称前的隐私提示，由 utils/privacy.js 唤起 -->
  <privacy-modal id="privacyModal" />
</view>
